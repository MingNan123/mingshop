# Copy to .dev.vars (gitignored) and fill in. Locally only this file is read; in
# production set secrets with `wrangler secret put <NAME>` and vars in wrangler.jsonc.

USE_A_LONG_RANDOM_STRING_FOR_SECRETS_KEK_AND_AUTH_SECRET=unused
SECRETS_KEK=
AUTH_SECRET=

# ── Waffo Pancake test integration ────────────────────────────────────────────
# Merchant ID: Dashboard → API & Development → top of page.
WAFFO_MERCHANT_ID=
# RSA private key. Keep this out of git; use a Worker secret in production.
WAFFO_PRIVATE_KEY=
# Existing one-time product ID from the Waffo Dashboard.
WAFFO_PRODUCT_ID=PROD_3bmPExtmoJjCk8GIl12Rai
# Tax category for the Waffo product.
WAFFO_TAX_CATEGORY=digital_goods

# Cloudflare Email Sending is optional and configured as a Wrangler binding.
