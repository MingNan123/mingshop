---
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import { formatPrice } from '../config';
import { readCart, resolveCart } from '../features/cart/cart';
import { shippingFor } from '../features/shipping/effective';
import { shipmentWeightFor } from '../features/shipping/lines';
import { stripeDestination } from '../features/shipping/destination';
import ProductImage from '../features/products/ProductImage.astro';
import { enabledMethods, isMethodAvailable } from '../features/payments';
import { catalogPath } from '../features/settings/home';
import { buyerRequirements } from '../features/checkout/buyer';
import CheckoutTurnstile from '../features/auth/CheckoutTurnstile.astro';

if (!(Astro.locals.settings?.cartEnabled ?? true)) return Astro.redirect('/', 302);

const settings = Astro.locals.settings;
const methods = settings ? enabledMethods(settings) : [];
const ready = (m: string) => !!settings && isMethodAvailable(m as never, settings);
const usdcReady = methods.includes('usdc') && ready('usdc');
const orderedMethods = usdcReady ? ['usdc', ...methods.filter((m) => m !== 'usdc')] : methods;
const preferredMethod = usdcReady ? 'usdc' : orderedMethods.find(ready);
const methodRows = orderedMethods.map((m) => ({ m, ready: ready(m), primary: m === preferredMethod }));
const METHOD: Record<string, { label: string; hint: string; setupHint: string }> = {
  stripe: { label: 'Pay with card', hint: 'Visa, Mastercard, Apple Pay & more', setupHint: 'Set up card payments' },
  waffo: { label: 'Pay with Waffo', hint: 'Secure hosted checkout', setupHint: 'Set up Waffo' },
  lightning: { label: 'Pay with Lightning ⚡', hint: 'Instant — from any Lightning wallet', setupHint: 'Set up Lightning' },
  opennode: { label: 'Pay with Bitcoin', hint: 'On-chain or Lightning (OpenNode)', setupHint: 'Set up OpenNode' },
  alipay: { label: 'Pay with Alipay', hint: 'Fixed order amount from product pricing', setupHint: 'Add Alipay link' },
  wechatpay: { label: 'Pay with WeChat Pay', hint: 'Fixed order amount from product pricing', setupHint: 'Add WeChat Pay link' },
  usdc: { label: 'Pay with USDC', hint: 'Fixed amount · automatically confirmed on-chain', setupHint: 'Configure USDC auto verification' },
  usdt: { label: 'Pay with USDT', hint: 'Fixed amount · automatically confirmed on-chain', setupHint: 'Configure USDT auto verification' },
};

const cart = readCart(Astro.cookies);
const { lines, subtotalCents } = await resolveCart(env.DB, cart);
const error = Astro.url.searchParams.get('error');
const effectiveShipping = shippingFor(settings).config;
const shippingRequired = shipmentWeightFor(lines).shippingRequired;
const stablecoinNeedsAddress = effectiveShipping.enabled && shippingRequired;
const destination = stripeDestination(
  settings,
  effectiveShipping,
  shippingRequired,
  Astro.request.headers.get('cf-ipcountry'),
);
const shopHref = catalogPath(Astro.locals.settings?.homePage);
const buyerFields = buyerRequirements(lines.map((line) => line.product));
const showBuyerFields = buyerFields.email || buyerFields.name || buyerFields.virtualRegion;
---

<Layout title="Cart">
  <h1 class="mb-10 font-serif text-4xl tracking-tight">Your cart</h1>

  {error && <p class="mb-8 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">{error}</p>}

  {lines.length === 0 ? (
    <p class="text-muted">Your cart is empty. <a href={shopHref} class="border-b border-brand text-brand">Continue shopping</a>.</p>
  ) : (
    <Fragment>
      <ul class="border-t border-line">
        {lines.map((l) => (
          <li class="flex flex-wrap items-center gap-x-4 gap-y-3 border-b border-line py-4">
            <a href={`/products/${l.product.slug}`} class="flex min-w-0 flex-1 basis-64 items-center gap-4 hover:text-brand">
              <ProductImage imageKey={l.product.image_key} alt="" usage="thumbnail" fade sizes="64px" class="h-16 w-16 shrink-0 rounded object-cover" />
              <span class="min-w-0">
                <span class="block truncate">{l.product.name}</span>
                {(l.variant || l.extras.length > 0) && <span class="block truncate text-xs text-muted">{[l.variant?.label, ...l.extras.map((e) => e.label)].filter(Boolean).join(' · ')}</span>}
                <span class="block text-xs tabular-nums text-muted">{formatPrice(l.unitPriceCents)} each</span>
                {l.availableStock <= 0 ? <span class="mt-1 block text-xs uppercase tracking-widest text-red-600">Out of stock</span> : l.qty > l.availableStock ? <span class="mt-1 block text-xs text-amber-700">Only {l.availableStock} available</span> : null}
              </span>
            </a>
            <div class="ml-auto flex items-center gap-4">
              <form method="POST" action="/api/cart" class="flex items-center gap-2">
                <input type="hidden" name="_action" value="update" /><input type="hidden" name="key" value={l.key} />
                <input type="number" name="qty" min="0" max="99" value={l.qty} aria-label="Quantity" class="w-14 border-b border-line bg-transparent py-1 text-center tabular-nums focus:border-brand focus:outline-none" />
                <button type="submit" class="text-xs uppercase tracking-widest text-faint hover:text-brand">Update</button>
              </form>
              <span class="w-20 text-right tabular-nums">{formatPrice(l.lineTotalCents)}</span>
              <form method="POST" action="/api/cart" class="flex items-center"><input type="hidden" name="_action" value="remove" /><input type="hidden" name="key" value={l.key} /><button type="submit" aria-label="Remove" class="text-xs uppercase tracking-widest text-faint hover:text-red-600">Remove</button></form>
            </div>
          </li>
        ))}
      </ul>

      <div class="mt-10 flex justify-end">
        <div class="w-full sm:max-w-sm">
          <div class="flex items-center justify-between"><span class="text-xs uppercase tracking-widest text-muted">Subtotal</span><span class="text-lg tabular-nums">{formatPrice(subtotalCents)}</span></div>
          <p class="mt-2 text-xs text-muted">The payable amount is locked to the current product, option and shipping prices stored by the shop.</p>
          {methods.length === 0 ? (
            <p class="mt-4 rounded-lg border border-dashed border-line px-5 py-4 text-center text-sm text-muted">Checkout is currently unavailable.</p>
          ) : (
            <form method="POST" action="/api/checkout" class="mt-4 space-y-2">
              <input type="hidden" name="source" value="cart" />
              {showBuyerFields && <div class="space-y-3 rounded-lg border border-line bg-surface p-4">
                <p class="text-sm font-medium">购买信息</p>
                {buyerFields.email && <label class="block text-sm"><span class="mb-1 block text-muted">邮箱</span><input type="email" name="email" required autocomplete="email" class="w-full rounded-md border border-line px-3 py-2" placeholder="用于接收订单和数字商品" /></label>}
                {buyerFields.name && <label class="block text-sm"><span class="mb-1 block text-muted">姓名</span><input type="text" name="name" required autocomplete="name" class="w-full rounded-md border border-line px-3 py-2" /></label>}
                {buyerFields.virtualRegion && <label class="block text-sm"><span class="mb-1 block text-muted">虚拟地区</span><input type="text" name="virtual_region" required class="w-full rounded-md border border-line px-3 py-2" placeholder="例如：香港、美国、日本" /></label>}
              </div>}
              {destination.showSelect && <label class="mb-2 flex items-center justify-between gap-2 text-xs uppercase tracking-widest text-muted">Ship to<select name="country" class="rounded-md border border-line px-2 py-1.5 text-sm normal-case tracking-normal text-ink">{destination.countries.map((c) => <option value={c} selected={c === destination.defaultCountry}>{destination.label(c)}</option>)}</select></label>}
              {destination.hiddenOnly && <input type="hidden" name="country" value={destination.countries[0]} />}
              <CheckoutTurnstile />
              {usdcReady && <aside aria-label="USDC payment recommendation" class="rounded-lg border border-brand/30 bg-brand/10 px-4 py-3 text-sm text-ink">
                <div class="flex items-start gap-3">
                  <span aria-hidden="true" class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full bg-brand font-semibold text-on-brand">$</span>
                  <span><strong class="block font-semibold text-brand">推荐优先使用 USDC 支付</strong><span class="mt-0.5 block text-xs leading-relaxed text-muted">金额稳定，付款后自动进行链上确认。请在下一步选择并使用页面显示的收款网络。</span></span>
                </div>
              </aside>}
              {methodRows.map(({ m, ready, primary }) => ready ? (
                <button type="submit" name="method" value={m} formaction={['waffo', 'usdc', 'usdt'].includes(m) && stablecoinNeedsAddress ? '/checkout' : undefined} formmethod={['waffo', 'usdc', 'usdt'].includes(m) && stablecoinNeedsAddress ? 'GET' : undefined} formtarget={m === 'waffo' ? '_blank' : undefined} class={`flex w-full items-center justify-between gap-3 rounded-lg px-5 py-3 text-left transition ${primary ? 'bg-brand text-on-brand hover:bg-brand-hover' : 'border border-line text-muted hover:border-brand'}`}>
                  <span><span class="flex items-center gap-2 text-sm font-medium">{METHOD[m]?.label ?? m}{m === 'usdc' && <span class={`rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider ${primary ? 'bg-on-brand/15 text-on-brand' : 'bg-brand/10 text-brand'}`}>推荐</span>}</span><span class={`block text-xs ${primary ? 'text-on-brand/70' : 'text-muted'}`}>{METHOD[m]?.hint ?? ''}</span></span><span aria-hidden="true" class={primary ? 'text-on-brand/80' : 'text-faint'}>&rarr;</span>
                </button>
              ) : (
                <a href={`/payment-setup?method=${m}`} class="flex w-full items-center justify-between gap-3 rounded-lg border border-dashed border-line px-5 py-3 text-left text-faint transition hover:border-brand hover:text-brand"><span><span class="block text-sm font-medium">{METHOD[m]?.label ?? m}</span><span class="block text-xs">{METHOD[m]?.setupHint ?? 'Set up'}</span></span><span aria-hidden="true">&rarr;</span></a>
              ))}
            </form>
          )}
        </div>
      </div>
    </Fragment>
  )}
</Layout>
