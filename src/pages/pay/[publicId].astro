---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { getConfig } from '../../config';
import { getPendingByPublicId, updatePendingEmail } from '../../features/payments/lightning/pending';
import { getOrderByPublicId } from '../../features/orders/db';
import { getStoreSettings } from '../../features/settings/db';
import { isLegacyPublicId } from '../../features/ids/publicId.ts';
import { isAccessToken } from '../../features/ids/token.ts';
import { resolveAccessToken } from '../../features/orders/guestAccess.ts';
import LightningPay from '../../features/payments/checkout/LightningPay.astro';
import ManualWalletCheckout from '../../features/payments/checkout/ManualWalletCheckout.astro';
import { settleLightningOnLoad, settleManualWalletCheckout } from '../../features/payments/checkout/settle';

const guestParam = Astro.params.publicId;
let orderPublicId: string | null = null;
if (guestParam && isAccessToken(guestParam)) {
  const access = await resolveAccessToken(env.DB, guestParam);
  orderPublicId = access?.order_public_id ?? null;
} else if (guestParam && isLegacyPublicId(guestParam)) {
  orderPublicId = guestParam;
}
if (!orderPublicId) return new Response('未找到订单', { status: 404 });

Astro.response.headers.set('cache-control', 'private, no-store');
Astro.response.headers.set('referrer-policy', 'no-referrer');
if (await getOrderByPublicId(env.DB, orderPublicId)) return Astro.redirect(`/order/${guestParam}`, 303);

let pending = await getPendingByPublicId(env.DB, orderPublicId);
if (!pending) return new Response('未找到订单', { status: 404 });
const settings = Astro.locals.settings ?? (await getStoreSettings(env.DB));
if (pending.backend === 'demo') return new Response('演示结账已停用，请重新选择真实支付方式。', { status: 410 });

const isLightning = pending.backend === 'lnbits' || pending.backend === 'phoenixd';
const isManualWallet = ['alipay','wechatpay','usdc','usdt'].includes(pending.backend);
const isStablecoin = pending.backend === 'usdc' || pending.backend === 'usdt';
if (!isLightning && !isManualWallet) return Astro.redirect(`/order/${guestParam}`, 303);

const payExpired = pending.status === 'expired' || (pending.expires_at != null && Date.parse(pending.expires_at) <= Date.now());
const ctx = Astro.locals.cfContext;
const waitUntil = ctx ? ctx.waitUntil.bind(ctx) : undefined;
let declined: string | null = null;

if (isStablecoin && Astro.request.method === 'POST' && !payExpired) {
  const form = await Astro.request.formData();
  const saved = await updatePendingEmail(env.DB, pending.public_id, String(form.get('email') ?? ''));
  if (!saved) declined = '请输入有效的接收订单确认邮箱。';
  else pending = (await getPendingByPublicId(env.DB, orderPublicId)) ?? pending;
} else if (isManualWallet && Astro.request.method === 'POST' && !payExpired) {
  const result = await settleManualWalletCheckout(pending, await Astro.request.formData(), Astro.url.origin, settings, waitUntil);
  if (result.settled) return Astro.redirect(`/order/${guestParam}`, 303);
  declined = result.declined ?? null;
}
if (isLightning && !payExpired && (await settleLightningOnLoad(pending, Astro.url.origin, settings, waitUntil))) {
  return Astro.redirect(`/order/${guestParam}`, 303);
}

const { storeName } = getConfig();
const title = isManualWallet ? '直连支付' : '使用闪电网络支付';
const description = isManualWallet ? `使用直连收款方式向 ${storeName} 支付。` : `使用比特币闪电网络向 ${storeName} 支付。`;
---

<Layout title={title} description={description}>
  {isLightning && <LightningPay pending={pending} expired={payExpired} />}
  {isManualWallet && payExpired && <Fragment><h1 class="mb-2 font-serif text-3xl tracking-tight sm:text-4xl">支付请求已过期</h1><p class="text-muted">本次支付请求已过期，请重新发起订单。</p></Fragment>}
  {isManualWallet && !payExpired && <ManualWalletCheckout pending={pending} settings={settings} declined={declined} />}
</Layout>
