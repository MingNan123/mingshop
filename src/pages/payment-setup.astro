---
export const prerender = false;
import Layout from '../layouts/Layout.astro';

const method = (Astro.url.searchParams.get('method') ?? '').toLowerCase();
const origin = Astro.url.origin;

interface Guide {
  title: string;
  intro: string;
  steps: string[];
}
const GUIDES: Record<string, Guide> = {
  stripe: {
    title: 'Set up card payments (Stripe)',
    intro: 'Accept Visa, Mastercard, Apple Pay and more via Stripe Checkout.',
    steps: [
      'Create a Stripe account and grab your Secret key from dashboard.stripe.com/apikeys.',
      'Paste it in Admin → Settings → Payment keys (Stripe secret key). It’s stored encrypted in your database.',
      `Add a webhook endpoint in Stripe pointing at ${origin}/api/webhook/stripe (events: checkout.session.completed, checkout.session.async_payment_succeeded, and charge.refunded).`,
      'Paste the signing secret into Payment keys. Product prices are read from the shop database when checkout starts.',
    ],
  },
  lightning: {
    title: 'Set up Lightning payments',
    intro: 'Take instant Bitcoin Lightning payments from any wallet.',
    steps: [
      'Stand up an LNbits instance (or a phoenixd node).',
      'In Admin → Settings → Payments, pick the node (LNbits or phoenixd).',
      'Enter the node URL and key. Lightning invoices are minted from the same fixed product/order amount used by the other payment methods.',
    ],
  },
  opennode: {
    title: 'Set up Bitcoin payments (OpenNode)',
    intro: 'Hosted on-chain + Lightning checkout via OpenNode.',
    steps: [
      'Create an OpenNode account and an API key.',
      'Paste it in Admin → Settings → Payment keys (OpenNode API key).',
      `Point its webhook at ${origin}/api/webhook/opennode. The checkout amount is generated from the product prices stored by the shop.`,
    ],
  },
  alipay: {
    title: 'Set up Alipay direct payments',
    intro: 'Accept Alipay using your own collection link while the shop locks the order amount to product pricing.',
    steps: [
      'Create or copy an Alipay merchant/personal collection link.',
      'Paste it in Admin → Settings → Payments → Alipay payment URL.',
      'Set each product’s fixed price in Admin → Products. The Alipay payment page will display that server-calculated amount (plus selected options/shipping) and buyers cannot edit it in checkout.',
    ],
  },
  wechatpay: {
    title: 'Set up WeChat Pay direct payments',
    intro: 'Accept WeChat Pay with your own collection link while the shop locks the order amount to product pricing.',
    steps: [
      'Create or copy a WeChat Pay collection link.',
      'Paste it in Admin → Settings → Payments → WeChat Pay payment URL.',
      'Set each product’s fixed price in Admin → Products. The WeChat Pay page will display the server-calculated amount (plus selected options/shipping) and buyers cannot edit it in checkout.',
    ],
  },
  usdc: {
    title: 'Set up USDC direct payments',
    intro: 'Accept USDC transfers to your own wallet using the same shop-calculated order amount.',
    steps: [
      'Choose a network your customers can use, such as Polygon, Base, Ethereum, or Solana.',
      'Paste the USDC receiving address and network in Admin → Settings → Payments.',
      'Set product prices in Admin → Products. The payment request displays the server-calculated fixed order amount and asks the buyer for the transaction hash/reference.',
    ],
  },
};
const guide = GUIDES[method] ?? null;
---

<Layout title="Set up payments" description="How to enable a payment method.">
  <div class="mx-auto max-w-xl py-8">
    <a href="/cart" class="text-xs uppercase tracking-widest text-faint hover:text-brand">&larr; Back to cart</a>
    {guide ? (
      <>
        <h1 class="mt-4 font-serif text-3xl tracking-tight">{guide.title}</h1>
        <p class="mt-3 text-muted">{guide.intro}</p>
        <ol class="mt-6 space-y-3">
          {guide.steps.map((s, i) => (
            <li class="flex gap-3 text-sm">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand/10 text-xs font-medium text-brand">{i + 1}</span>
              <span class="pt-0.5 text-muted">{s}</span>
            </li>
          ))}
        </ol>
      </>
    ) : (
      <>
        <h1 class="mt-4 font-serif text-3xl tracking-tight">Set up payments</h1>
        <p class="mt-3 text-muted">This payment method isn't configured. Configure a real payment method in Admin → Settings → Payments before accepting orders.</p>
      </>
    )}

    <div class="mt-8 rounded-md border border-line bg-surface px-4 py-3 text-sm text-muted">
      All payment methods use product prices resolved by the server at checkout. No demo checkout or simulated order path is offered.
    </div>
  </div>
</Layout>
