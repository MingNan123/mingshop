---
export const prerender = false;
import Layout from '../layouts/Layout.astro';

const method = (Astro.url.searchParams.get('method') ?? '').toLowerCase();

interface Guide {
  title: string;
  intro: string;
  steps: string[];
}

const GUIDES: Record<string, Guide> = {
  usdc: {
    title: '配置 USDC 自动收款',
    intro: '商家可以启用多个 USDC 网络；买家付款时只能从你启用的网络中选择，并在订单上永久锁定该网络。',
    steps: [
      '店铺币种保持为 USD，然后打开「后台 → 稳定币收款」。',
      '新增一个或多个 USDC 网络配置，填写网络名称、收款地址、可信 HTTPS RPC、该网络官方 USDC 合约、Decimals 和确认数。',
      '只勾选你实际愿意接收的网络。买家结账时只会看到这些已启用的 USDC 网络。',
      '买家锁定网络后，订单会保存该网络的收款地址、代币合约、RPC、Decimals 和确认规则快照，之后不能换链。',
      'Cloudflare Cron 仅按照订单锁定的网络扫描链上转账，并核对合约、收款地址、精确金额、时间窗口、确认数和交易哈希唯一性后自动完成订单。',
    ],
  },
  usdt: {
    title: '配置 USDT 自动收款',
    intro: 'USDT 支持商家启用多个网络；买家从同一组已启用网络中选择，订单锁定后双方网络保持一致。',
    steps: [
      '店铺币种保持为 USD，然后打开「后台 → 稳定币收款」。',
      'TRON / TRC-20：填写 T 地址、可信 TronGrid/兼容索引器、官方 USDT 合约和确认规则；使用官方 TronGrid 时可在 Secret Vault 保存 API Key。',
      'EVM / ERC-20：填写网络名称、0x 收款地址、可信 HTTPS RPC、该网络官方 USDT 合约、Decimals 和确认数。',
      '可以同时启用多个 USDT 网络。买家只能从你启用的网络中选择，不能提交任意网络名称。',
      '买家锁定网络后，该订单的网络快照不可更改；自动验单也只扫描这个订单对应的网络，避免跨链错配。',
    ],
  },
};

const guide = GUIDES[method] ?? null;
---

<Layout title="稳定币收款设置" description="配置 USDC / USDT 固定金额与多网络自动验单。">
  <div class="mx-auto max-w-xl py-8">
    <a href="/cart" class="text-xs uppercase tracking-widest text-faint hover:text-brand">&larr; 返回购物车</a>
    {guide ? (
      <>
        <h1 class="mt-4 font-serif text-3xl tracking-tight">{guide.title}</h1>
        <p class="mt-3 text-muted">{guide.intro}</p>
        <ol class="mt-6 space-y-3">
          {guide.steps.map((s, i) => (
            <li class="flex gap-3 text-sm">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand/10 text-xs font-medium text-brand">{i + 1}</span>
              <span class="pt-0.5 text-muted">{s}</span>
            </li>
          ))}
        </ol>
      </>
    ) : (
      <>
        <h1 class="mt-4 font-serif text-3xl tracking-tight">仅支持 USDC / USDT</h1>
        <p class="mt-3 text-muted">新的结账订单只接受 USDC 和 USDT。请在「后台 → 稳定币收款」中配置并启用至少一个对应网络。</p>
      </>
    )}

    <div class="mt-8 rounded-md border border-line bg-surface px-4 py-3 text-sm text-muted">
      应付金额始终由服务器根据商品、选项和运费计算。买家选择的稳定币网络会写入订单快照并锁定，付款币种、网络和商家收款配置必须保持一致。
    </div>
  </div>
</Layout>
