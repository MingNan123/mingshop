---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import { getConfig, formatPrice } from '../config';
import { readCart, resolveCart } from '../features/cart/cart';
import { getProductByPublicId, type Product } from '../features/products/db';
import { listVariants, getExtrasByPublicIds, type ProductVariant } from '../features/products/variants';
import { parsePublicId } from '../features/ids/publicId';
import { claimOrderIdentity, deleteGuestAccessIfUnsettled } from '../features/orders/guestAccess';
import { lineUnitPriceCents } from '../features/cart/key';
import { quoteShipping, allowedCountries, hasCatchAllZone } from '../features/shipping/calculator';
import { countryOptions, countryName, isCountryCode } from '../features/shipping/countries';
import { shippingFor } from '../features/shipping/effective';
import { shipmentWeightFor } from '../features/shipping/lines';
import { getLightningBackend } from '../features/payments/lightning';
import { mintLightningOrder } from '../features/payments/lightning-provider';
import { isMethodAvailable, getPaymentProvider } from '../features/payments';
import { MANUAL_WALLET_CHECKOUT_TTL_SECONDS } from '../features/payments/manual-wallet';
import { reserveInventory, releaseInventoryReservation } from '../features/orders/reservations';
import { reservationItems } from '../features/orders/reservationItems.ts';
import { purgeStockProductCache } from '../features/cache/purge';

const cfg = getConfig();
const isPost = Astro.request.method === 'POST';
const form = isPost ? await Astro.request.formData() : null;
const fld = (name: string) => (form?.get(name) ?? '').toString().trim();

// Rails that need the shop's own address/shipping step. Their charge amount is
// rebuilt here from the current D1 product/variant/extra rows; no posted amount is accepted.
const IN_APP_RAILS = ['lightning', 'opennode', 'alipay', 'wechatpay', 'usdc', 'usdt'] as const;
type InAppRail = (typeof IN_APP_RAILS)[number];
const requestedRail = (fld('method') || Astro.url.searchParams.get('method') || '').trim();
if (!(IN_APP_RAILS as readonly string[]).includes(requestedRail)) return Astro.redirect('/cart', 303);
const rail = requestedRail as InAppRail;
if (!Astro.locals.settings || !isMethodAvailable(rail, Astro.locals.settings)) return Astro.redirect('/cart', 303);

const productPublicId = parsePublicId(fld('product_id') || (Astro.url.searchParams.get('product_id') ?? ''), 'product');
const buyNowVariantId = parsePublicId(fld('variant_id') || Astro.url.searchParams.get('variant_id') || '', 'variant');
const buyNowExtraIds = (isPost ? form!.getAll('extra') : Astro.url.searchParams.getAll('extra'))
  .map((e) => parsePublicId(e, 'extra'))
  .filter((x): x is string => x !== null);

interface CheckoutLine {
  product: Product;
  qty: number;
  name: string;
  unitPriceCents: number;
  variantId: number | null;
  variant: ProductVariant | null;
}
let lines: CheckoutLine[] = [];
if (productPublicId) {
  const product = await getProductByPublicId(env.DB, productPublicId);
  if (product && product.active) {
    const variants = await listVariants(env.DB, product.id);
    const variant = variants.length > 0 && buyNowVariantId ? (variants.find((v) => v.public_id === buyNowVariantId) ?? null) : null;
    const extras = buyNowExtraIds.length ? await getExtrasByPublicIds(env.DB, product.id, buyNowExtraIds) : [];
    lines = [{
      product,
      qty: 1,
      name: product.name + (variant ? ` — ${variant.label}` : '') + (extras.length ? ` (${extras.map((e) => e.label).join(', ')})` : ''),
      unitPriceCents: lineUnitPriceCents(product.price_cents, variant, extras),
      variantId: variant?.id ?? null,
      variant,
    }];
  }
} else {
  const { lines: cartLines } = await resolveCart(env.DB, readCart(Astro.cookies));
  lines = cartLines.map((l) => ({
    product: l.product,
    qty: l.qty,
    name: l.product.name + (l.variant ? ` — ${l.variant.label}` : '') + (l.extras.length ? ` (${l.extras.map((e) => e.label).join(', ')})` : ''),
    unitPriceCents: l.unitPriceCents,
    variantId: l.variant?.id ?? null,
    variant: l.variant,
  }));
}
if (lines.length === 0) return Astro.redirect('/cart', 303);

const subtotalCents = lines.reduce((s, l) => s + l.unitPriceCents * l.qty, 0);
const currency = cfg.currency;
const effectiveShipping = shippingFor(Astro.locals.settings).config;
const knownCountries = allowedCountries(effectiveShipping);
const shipsAnywhere = hasCatchAllZone(effectiveShipping);
const geoCountry = String(Astro.request.headers.get('cf-ipcountry') ?? '').toUpperCase();
const geoDefault = isCountryCode(geoCountry) && (shipsAnywhere || knownCountries.includes(geoCountry)) ? geoCountry : null;
const destinationChoices = shipsAnywhere
  ? countryOptions()
  : knownCountries.map((code) => ({ code, name: countryName(code) })).sort((a, b) => a.name.localeCompare(b.name));
const shipment = shipmentWeightFor(lines);
const carry = productPublicId ?? '';
const carryVariantId = buyNowVariantId ?? '';
const carryExtraIds = buyNowExtraIds;
const editAddressHref = (() => {
  const params = new URLSearchParams({ method: rail });
  if (carry) params.set('product_id', carry);
  if (carryVariantId) params.set('variant_id', carryVariantId);
  for (const id of carryExtraIds) params.append('extra', id);
  return `/checkout?${params}`;
})();
const RAIL_LABEL: Record<InAppRail, string> = {
  lightning: 'Pay with Lightning',
  opennode: 'Pay with Bitcoin',
  alipay: 'Pay with Alipay',
  wechatpay: 'Pay with WeChat Pay',
  usdc: 'Pay with USDC',
  usdt: 'Pay with USDT',
};
const addr = {
  email: fld('email'), name: fld('name'), line1: fld('line1'), line2: fld('line2'), city: fld('city'), state: fld('state'), postal: fld('postal'),
  country: (fld('country') || geoDefault || knownCountries[0] || 'US').toUpperCase(),
};
let stage: 'address' | 'shipping' = 'address';
let options: { label: string; amountCents: number; pickup?: boolean }[] = [];
const errors: string[] = [];

if (isPost) {
  if (!/.+@.+\..+/.test(addr.email)) errors.push('A valid email is required.');
  if (!addr.name) errors.push('Name is required.');
  if (!addr.line1) errors.push('Address is required.');
  if (!addr.city) errors.push('City is required.');
  if (!addr.postal) errors.push('Postal code is required.');
  if (addr.country.length !== 2) errors.push('Use a 2-letter country code (e.g. US).');
  if (errors.length === 0) {
    const quote = quoteShipping(effectiveShipping, { subtotalCents, country: addr.country, itemWeightGrams: shipment.itemWeightGrams, missingWeight: shipment.missingWeight });
    options = quote.options;
    if (options.length === 0) {
      const missing = quote.omitted.some((o) => o.reason === 'missing_weight');
      const overweight = quote.omitted.some((o) => o.reason === 'overweight');
      if (missing) errors.push(`We can't calculate shipping for ${quote.missingWeight.map((m) => m.name).join(', ')} right now. Please contact us to complete this order.`);
      else if (overweight) errors.push('This order is too heavy for the available shipping services.');
      else errors.push(`Sorry, we don't ship to ${addr.country} yet.`);
    } else {
      stage = 'shipping';
      const chosenLabel = fld('shipping_label');
      if (chosenLabel) {
        const chosen = options.find((o) => o.label === chosenLabel);
        if (!chosen) errors.push('Please choose a shipping option.');
        else {
          const { publicId, accessToken } = await claimOrderIdentity(env.DB);
          const reservationTtl = rail === 'alipay' || rail === 'wechatpay' || rail === 'usdc' || rail === 'usdt'
            ? MANUAL_WALLET_CHECKOUT_TTL_SECONDS
            : cfg.payments.lightning.invoiceExpiryMinutes * 60 + 5 * 60;
          const reserved = await reserveInventory(env.DB, publicId, reservationItems(lines), reservationTtl, rail, purgeStockProductCache);
          if (!reserved) {
            await deleteGuestAccessIfUnsettled(env.DB, publicId);
            errors.push('Some inventory just sold out — please review your cart.');
          } else {
            const shippingAddress = { name: addr.name, line1: addr.line1, line2: addr.line2 || null, city: addr.city, state: addr.state || null, postal: addr.postal, country: addr.country };
            const itemsJson = JSON.stringify(lines.map((l) => ({ id: l.product.id, v: l.variantId, q: l.qty, n: l.name, p: l.unitPriceCents })));
            try {
              if (rail !== 'lightning') {
                const provider = await getPaymentProvider(rail);
                const result = await provider.createCheckout({
                  lineItems: lines.map((l) => ({ name: l.name, amountCents: l.unitPriceCents, currency, quantity: l.qty })),
                  successUrl: `${Astro.url.origin}/order/${accessToken}`,
                  cancelUrl: `${Astro.url.origin}/cart`,
                  orderItemsJson: itemsJson,
                  metadata: { public_id: publicId, reservation_id: publicId },
                  accessToken,
                  selectedShipping: { label: chosen.label, amountCents: chosen.amountCents, weightGrams: quote.shipmentWeightGrams, deliveryMethod: chosen.pickup ? 'pickup' : 'shipping', address: shippingAddress, email: addr.email },
                });
                return Astro.redirect(result.url, 303);
              }
              const minted = await mintLightningOrder(env.DB, await getLightningBackend(), {
                origin: Astro.url.origin, publicId, accessToken, currency, subtotalCents,
                shippingCents: chosen.amountCents, shippingLabel: chosen.label, shippingWeightGrams: quote.shipmentWeightGrams,
                deliveryMethod: chosen.pickup ? 'pickup' : 'shipping', itemsJson, email: addr.email, shippingAddress, reservationId: publicId,
              });
              if (!minted.payUrl) throw new Error('Lightning backend did not return a payment URL.');
              return Astro.redirect(minted.payUrl, 303);
            } catch (error) {
              await releaseInventoryReservation(env.DB, publicId, purgeStockProductCache);
              await deleteGuestAccessIfUnsettled(env.DB, publicId);
              console.error(JSON.stringify({ event: rail === 'lightning' ? 'lightning_invoice_failed' : 'checkout_create_failed', rail, message: error instanceof Error ? error.message : String(error) }));
              errors.push('Payment could not be started. Please try again.');
            }
          }
        }
      }
    }
  }
}
const showShipping = stage === 'shipping';
const hasErrors = errors.length > 0;
---

<Layout title="Checkout" description="Enter your shipping details.">
  <div class="mx-auto max-w-lg">
    <h1 class="mb-1 font-serif text-3xl tracking-tight sm:text-4xl">Checkout</h1>
    <p class="mb-2 text-sm text-muted">Subtotal {formatPrice(subtotalCents, currency)} · {lines.length} item{lines.length === 1 ? '' : 's'}</p>
    <p class="mb-6 text-xs text-muted">Amount is calculated from the current product prices saved in the shop and cannot be edited at checkout.</p>
    {hasErrors && <ul class="mb-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-700">{errors.map((e) => <li>{e}</li>)}</ul>}
    {showShipping ? (
      <form method="POST" action="/checkout" class="space-y-4">
        <input type="hidden" name="method" value={rail} /><input type="hidden" name="product_id" value={carry} />
        {carryVariantId && <input type="hidden" name="variant_id" value={carryVariantId} />}{carryExtraIds.map((id) => <input type="hidden" name="extra" value={id} />)}
        <input type="hidden" name="email" value={addr.email} /><input type="hidden" name="name" value={addr.name} /><input type="hidden" name="line1" value={addr.line1} /><input type="hidden" name="line2" value={addr.line2} /><input type="hidden" name="city" value={addr.city} /><input type="hidden" name="state" value={addr.state} /><input type="hidden" name="postal" value={addr.postal} /><input type="hidden" name="country" value={addr.country} />
        <div class="rounded-lg border border-line bg-surface p-4 text-sm"><div class="mb-1 font-medium">Ship to</div><div class="text-muted">{addr.name}, {addr.line1}{addr.line2 ? `, ${addr.line2}` : ''}, {addr.city} {addr.state} {addr.postal}, {addr.country}</div><a href={editAddressHref} class="mt-2 inline-block text-xs font-medium text-accent">Edit address</a></div>
        <fieldset class="space-y-2"><legend class="mb-1 text-sm font-medium">Shipping</legend>{options.map((o, i) => <label class="flex cursor-pointer items-center justify-between rounded-lg border border-line bg-surface p-3 text-sm has-[:checked]:border-brand"><span class="flex items-center gap-2"><input type="radio" name="shipping_label" value={o.label} checked={i === 0} />{o.label}</span><span class="text-muted">{o.amountCents === 0 ? 'Free' : formatPrice(o.amountCents, currency)} · total {formatPrice(subtotalCents + o.amountCents, currency)}</span></label>)}</fieldset>
        <button type="submit" class="w-full rounded-md bg-brand px-4 py-2.5 font-medium text-on-brand hover:bg-brand-hover">{RAIL_LABEL[rail]} →</button>
      </form>
    ) : (
      <form method="POST" action="/checkout" class="space-y-3">
        <input type="hidden" name="method" value={rail} /><input type="hidden" name="product_id" value={carry} />{carryVariantId && <input type="hidden" name="variant_id" value={carryVariantId} />}{carryExtraIds.map((id) => <input type="hidden" name="extra" value={id} />)}
        <label class="block text-sm"><span class="mb-1 block font-medium">Email</span><input type="email" name="email" value={addr.email} required class="w-full rounded-md border border-line px-3 py-2" /></label>
        <label class="block text-sm"><span class="mb-1 block font-medium">Full name</span><input type="text" name="name" value={addr.name} required class="w-full rounded-md border border-line px-3 py-2" /></label>
        <label class="block text-sm"><span class="mb-1 block font-medium">Address</span><input type="text" name="line1" value={addr.line1} required class="w-full rounded-md border border-line px-3 py-2" /></label>
        <label class="block text-sm"><span class="mb-1 block font-medium">Apartment, suite, etc. (optional)</span><input type="text" name="line2" value={addr.line2} class="w-full rounded-md border border-line px-3 py-2" /></label>
        <div class="grid grid-cols-2 gap-3"><label class="block text-sm"><span class="mb-1 block font-medium">City</span><input type="text" name="city" value={addr.city} required class="w-full rounded-md border border-line px-3 py-2" /></label><label class="block text-sm"><span class="mb-1 block font-medium">State / Province</span><input type="text" name="state" value={addr.state} class="w-full rounded-md border border-line px-3 py-2" /></label></div>
        <div class="grid grid-cols-2 gap-3"><label class="block text-sm"><span class="mb-1 block font-medium">Postal code</span><input type="text" name="postal" value={addr.postal} required class="w-full rounded-md border border-line px-3 py-2" /></label><label class="block text-sm"><span class="mb-1 block font-medium">Country</span><select name="country" required class="w-full rounded-md border border-line px-3 py-2 bg-surface">{destinationChoices.map((c) => <option value={c.code} selected={c.code === addr.country}>{c.name}</option>)}</select></label></div>
        {knownCountries.length > 0 && <p class="text-xs text-faint">Ships to: {knownCountries.join(', ')}</p>}
        <button type="submit" class="w-full rounded-md bg-brand px-4 py-2.5 font-medium text-on-brand hover:bg-brand-hover">Continue to shipping →</button>
      </form>
    )}
  </div>
</Layout>