---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import { formatPrice } from '../config';
import { getProductByPublicId } from '../features/products/db';
import { listVariants, getExtrasByPublicIds } from '../features/products/variants';
import { parsePublicId } from '../features/ids/publicId.ts';
import { lineUnitPriceCents } from '../features/cart/key';
import { shippingFor } from '../features/shipping/effective';
import { shipmentWeightFor } from '../features/shipping/lines';
import { stripeDestination } from '../features/shipping/destination';
import { readCart, resolveCart } from '../features/cart/cart';
import { enabledMethods } from '../features/payments';
import ProductImage from '../features/products/ProductImage.astro';

const isPost = Astro.request.method === 'POST';
const form = isPost ? await Astro.request.formData() : null;
const fld = (n: string) => (form?.get(n) ?? Astro.url.searchParams.get(n) ?? '').toString().trim();

interface DisplayLine { name: string; imageKey: string | null; unitPriceCents: number; qty: number; }
const productPublicId = parsePublicId(fld('product_id'), 'product');
const isBuyNow = productPublicId !== null;
let lines: DisplayLine[] = [];
let weightLines: Parameters<typeof shipmentWeightFor>[0] = [];
let carry: { name: string; value: string }[] = [];
let backHref = '/';

if (isBuyNow && productPublicId) {
  const product = await getProductByPublicId(env.DB, productPublicId);
  if (!product || !product.active) return Astro.redirect('/', 303);
  backHref = `/products/${product.slug}`;
  const variantPublicId = parsePublicId(fld('variant_id'), 'variant');
  const extraPublicIds = (isPost ? form!.getAll('extra') : Astro.url.searchParams.getAll('extra'))
    .map((e) => parsePublicId(e, 'extra')).filter((x): x is string => x !== null);
  const variants = await listVariants(env.DB, product.id);
  const variant = variants.length > 0 && variantPublicId ? (variants.find((v) => v.public_id === variantPublicId) ?? null) : null;
  if (variants.length > 0 && !variant) return Astro.redirect(`/products/${product.slug}?error=${encodeURIComponent(`Please choose a ${product.variant_label || 'option'}.`)}`, 303);
  const extras = extraPublicIds.length ? await getExtrasByPublicIds(env.DB, product.id, extraPublicIds) : [];
  if ((variant ? variant.stock : product.stock) <= 0) return Astro.redirect(`/products/${product.slug}?error=Sold+out`, 303);
  lines = [{ name: product.name + (variant ? ` — ${variant.label}` : '') + (extras.length ? ` (${extras.map((e) => e.label).join(', ')})` : ''), imageKey: product.image_key, unitPriceCents: lineUnitPriceCents(product.price_cents, variant, extras), qty: 1 }];
  weightLines = [{ product, variant, qty: 1 }];
  carry = [{ name: 'product_id', value: productPublicId }];
  if (variant?.public_id) carry.push({ name: 'variant_id', value: variant.public_id });
  for (const e of extras) if (e.public_id) carry.push({ name: 'extra', value: e.public_id });
} else {
  const { lines: cartLines } = await resolveCart(env.DB, readCart(Astro.cookies));
  if (cartLines.length === 0) return Astro.redirect('/cart', 303);
  const short = cartLines.find((l) => l.qty > l.availableStock);
  if (short) return Astro.redirect(`/cart?error=${encodeURIComponent('Some items are no longer available in the quantity you selected. Please review your cart.')}`, 303);
  backHref = '/cart';
  lines = cartLines.map((l) => ({ name: l.product.name + (l.variant ? ` — ${l.variant.label}` : '') + (l.extras.length ? ` (${l.extras.map((e) => e.label).join(', ')})` : ''), imageKey: l.product.image_key, unitPriceCents: l.unitPriceCents, qty: l.qty }));
  weightLines = cartLines.map((l) => ({ product: l.product, variant: l.variant, qty: l.qty }));
  carry = [{ name: 'source', value: 'cart' }];
}

const totalCents = lines.reduce((s, l) => s + l.unitPriceCents * l.qty, 0);
const methods = Astro.locals.settings ? enabledMethods(Astro.locals.settings) : [];
if (methods.length === 0) return Astro.redirect(backHref, 303);
const effectiveShipping = shippingFor(Astro.locals.settings).config;
const shippingRequired = shipmentWeightFor(weightLines).shippingRequired;
const usdtNeedsAddress = effectiveShipping.enabled && shippingRequired;
const destination = stripeDestination(Astro.locals.settings, effectiveShipping, shippingRequired, Astro.request.headers.get('cf-ipcountry'));
const heading = isBuyNow ? 'Buy now' : 'Checkout';
const METHOD: Record<string, { label: string; hint: string }> = {
  stripe: { label: 'Pay with card', hint: 'Visa, Mastercard, Apple Pay & more' },
  waffo: { label: 'Pay with Waffo', hint: 'Secure hosted checkout' },
  lightning: { label: 'Pay with Lightning ⚡', hint: 'Instant — fixed shop amount' },
  opennode: { label: 'Pay with Bitcoin', hint: 'On-chain or Lightning (OpenNode)' },
  alipay: { label: 'Pay with Alipay', hint: 'Fixed amount from product pricing' },
  wechatpay: { label: 'Pay with WeChat Pay', hint: 'Fixed amount from product pricing' },
  usdc: { label: 'Pay with USDC', hint: 'Fixed amount · automatically confirmed on-chain' },
  usdt: { label: 'Pay with USDT', hint: 'Fixed amount · automatically confirmed on-chain' },
};
---

<Layout title="Checkout" description="Express checkout.">
  <div class="mx-auto max-w-md">
    <p class="text-xs uppercase tracking-[0.25em] text-muted">Express checkout</p>
    <h1 class="mt-2 mb-6 font-serif text-3xl tracking-tight sm:text-4xl">{heading}</h1>
    <ul class="divide-y divide-line border-y border-line">{lines.map((l) => <li class="flex items-center gap-4 py-4"><ProductImage imageKey={l.imageKey} alt="" usage="thumbnail" fade class="h-16 w-16 shrink-0 rounded object-cover" /><div class="min-w-0 flex-1"><p class="truncate text-sm font-medium">{l.name}</p><p class="text-xs text-muted">Qty {l.qty}</p></div><span class="tabular-nums">{formatPrice(l.unitPriceCents * l.qty)}</span></li>)}</ul>
    <div class="mt-4 flex items-center justify-between"><span class="text-xs uppercase tracking-widest text-muted">Fixed total</span><span class="text-lg tabular-nums">{formatPrice(totalCents)}</span></div>
    <p class="mt-2 text-xs text-muted">All payment methods use the current product prices saved by the shop. The amount cannot be edited at checkout.</p>
    <div class="mt-6 space-y-2">{methods.map((m, i) => {
      const usdtAddressStep = m === 'usdt' && usdtNeedsAddress;
      return <form method={usdtAddressStep ? 'GET' : 'POST'} action={usdtAddressStep ? '/checkout' : '/api/checkout'}>{carry.map((c) => <input type="hidden" name={c.name} value={c.value} />)}<input type="hidden" name="method" value={m} />{m === 'stripe' && destination.showSelect && <label class="mb-2 flex items-center justify-between gap-2 text-xs uppercase tracking-widest text-muted">Ship to<select name="country" class="rounded-md border border-line px-2 py-1.5 text-sm normal-case tracking-normal text-ink">{destination.countries.map((c) => <option value={c} selected={c === destination.defaultCountry}>{destination.label(c)}</option>)}</select></label>}{m === 'stripe' && destination.hiddenOnly && <input type="hidden" name="country" value={destination.countries[0]} />}<button type="submit" class={`flex w-full items-center justify-between gap-3 rounded-lg px-5 py-3 text-left transition ${i === 0 ? 'bg-brand text-on-brand hover:bg-brand-hover' : 'border border-line text-muted hover:border-brand'}`}><span><span class="block text-sm font-medium">{METHOD[m]?.label ?? m}</span><span class={`block text-xs ${i === 0 ? 'text-on-brand/70' : 'text-muted'}`}>{METHOD[m]?.hint ?? ''}</span></span><span aria-hidden="true" class={i === 0 ? 'text-on-brand/80' : 'text-faint'}>&rarr;</span></button></form>;
    })}</div>
    <a href={backHref} class="mt-6 inline-block text-xs uppercase tracking-widest text-faint hover:text-brand">&larr; Back</a>
  </div>
</Layout>