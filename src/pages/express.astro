---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import { formatPrice } from '../config';
import { getProductByPublicId } from '../features/products/db';
import { listVariants, getExtrasByPublicIds } from '../features/products/variants';
import { parsePublicId } from '../features/ids/publicId.ts';
import { lineUnitPriceCents } from '../features/cart/key';
import { shippingFor } from '../features/shipping/effective';
import { shipmentWeightFor } from '../features/shipping/lines';
import { stripeDestination } from '../features/shipping/destination';
import { readCart, resolveCart } from '../features/cart/cart';
import { enabledMethods } from '../features/payments';
import ProductImage from '../features/products/ProductImage.astro';
import { buyerRequirements } from '../features/checkout/buyer';
import CheckoutTurnstile from '../features/auth/CheckoutTurnstile.astro';

const isPost = Astro.request.method === 'POST';
const form = isPost ? await Astro.request.formData() : null;
const fld = (n: string) => (form?.get(n) ?? Astro.url.searchParams.get(n) ?? '').toString().trim();

interface DisplayLine { name: string; imageKey: string | null; unitPriceCents: number; qty: number; }
const productPublicId = parsePublicId(fld('product_id'), 'product');
const isBuyNow = productPublicId !== null;
let lines: DisplayLine[] = [];
let weightLines: Parameters<typeof shipmentWeightFor>[0] = [];
let carry: { name: string; value: string }[] = [];
let backHref = '/';

if (isBuyNow && productPublicId) {
  const product = await getProductByPublicId(env.DB, productPublicId);
  if (!product || !product.active) return Astro.redirect('/', 303);
  backHref = `/products/${product.slug}`;
  const variantPublicId = parsePublicId(fld('variant_id'), 'variant');
  const extraPublicIds = (isPost ? form!.getAll('extra') : Astro.url.searchParams.getAll('extra'))
    .map((e) => parsePublicId(e, 'extra')).filter((x): x is string => x !== null);
  const variants = await listVariants(env.DB, product.id);
  const variant = variants.length > 0 && variantPublicId ? (variants.find((v) => v.public_id === variantPublicId) ?? null) : null;
  if (variants.length > 0 && !variant) return Astro.redirect(`/products/${product.slug}?error=${encodeURIComponent(`Please choose a ${product.variant_label || 'option'}.`)}`, 303);
  const extras = extraPublicIds.length ? await getExtrasByPublicIds(env.DB, product.id, extraPublicIds) : [];
  if ((variant ? variant.stock : product.stock) <= 0) return Astro.redirect(`/products/${product.slug}?error=Sold+out`, 303);
  lines = [{ name: product.name + (variant ? ` — ${variant.label}` : '') + (extras.length ? ` (${extras.map((e) => e.label).join(', ')})` : ''), imageKey: product.image_key, unitPriceCents: lineUnitPriceCents(product.price_cents, variant, extras), qty: 1 }];
  weightLines = [{ product, variant, qty: 1 }];
  carry = [{ name: 'product_id', value: productPublicId }];
  if (variant?.public_id) carry.push({ name: 'variant_id', value: variant.public_id });
  for (const e of extras) if (e.public_id) carry.push({ name: 'extra', value: e.public_id });
} else {
  const { lines: cartLines } = await resolveCart(env.DB, readCart(Astro.cookies));
  if (cartLines.length === 0) return Astro.redirect('/cart', 303);
  const short = cartLines.find((l) => l.qty > l.availableStock);
  if (short) return Astro.redirect(`/cart?error=${encodeURIComponent('Some items are no longer available in the quantity you selected. Please review your cart.')}`, 303);
  backHref = '/cart';
  lines = cartLines.map((l) => ({ name: l.product.name + (l.variant ? ` — ${l.variant.label}` : '') + (l.extras.length ? ` (${l.extras.map((e) => e.label).join(', ')})` : ''), imageKey: l.product.image_key, unitPriceCents: l.unitPriceCents, qty: l.qty }));
  weightLines = cartLines.map((l) => ({ product: l.product, variant: l.variant, qty: l.qty }));
  carry = [{ name: 'source', value: 'cart' }];
}

const totalCents = lines.reduce((s, l) => s + l.unitPriceCents * l.qty, 0);
const methods = Astro.locals.settings ? enabledMethods(Astro.locals.settings) : [];
if (methods.length === 0) return Astro.redirect(backHref, 303);
const effectiveShipping = shippingFor(Astro.locals.settings).config;
const shippingRequired = shipmentWeightFor(weightLines).shippingRequired;
const stablecoinNeedsAddress = effectiveShipping.enabled && shippingRequired;
const destination = stripeDestination(Astro.locals.settings, effectiveShipping, shippingRequired, Astro.request.headers.get('cf-ipcountry'));
const heading = isBuyNow ? '立即购买' : '确认订单';
const error = Astro.url.searchParams.get('error');
const buyerFields = buyerRequirements(weightLines.map((line) => line.product));
const showBuyerFields = buyerFields.email || buyerFields.name || buyerFields.virtualRegion;
const METHOD: Record<string, { label: string; hint: string }> = {
  stripe: { label: 'Pay with card', hint: 'Visa, Mastercard, Apple Pay & more' },
  waffo: { label: 'Waffo 支付', hint: '微信支付 · 银行卡 · Apple Pay · Google Pay' },
  lightning: { label: 'Pay with Lightning ⚡', hint: 'Instant — fixed shop amount' },
  opennode: { label: 'Pay with Bitcoin', hint: 'On-chain or Lightning (OpenNode)' },
  alipay: { label: 'Pay with Alipay', hint: 'Fixed amount from product pricing' },
  wechatpay: { label: 'Pay with WeChat Pay', hint: 'Fixed amount from product pricing' },
  usdc: { label: 'USDC 支付', hint: '按页面金额转账，到账后自动确认' },
  usdt: { label: 'USDT 支付', hint: '按页面金额转账，到账后自动确认' },
};
---

<Layout title="确认订单" description="核对商品信息并选择支付方式。">
  <div class="mx-auto max-w-md">
    <p class="text-xs uppercase tracking-[0.25em] text-muted">确认商品 · 填写信息 · 选择支付</p>
    <h1 class="mt-2 mb-6 font-serif text-3xl tracking-tight sm:text-4xl">{heading}</h1>
    {error && <p role="alert" class="mb-4 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">{error}</p>}
    <ul class="divide-y divide-line border-y border-line">{lines.map((l) => <li class="flex items-center gap-4 py-4"><ProductImage imageKey={l.imageKey} alt="" usage="thumbnail" fade class="h-16 w-16 shrink-0 rounded object-cover" /><div class="min-w-0 flex-1"><p class="break-words text-sm font-medium leading-6">{l.name}</p><p class="text-xs text-muted">数量 {l.qty}</p></div><span class="tabular-nums">{formatPrice(l.unitPriceCents * l.qty)}</span></li>)}</ul>
    <div class="mt-4 flex items-center justify-between"><span class="text-xs uppercase tracking-widest text-muted">商品合计</span><span class="text-lg tabular-nums">{formatPrice(totalCents)}</span></div>
    <p class="mt-2 text-xs text-muted">金额由系统按商品价格计算；如需配送，运费将在后续步骤确认。</p>
    <form method="POST" action="/api/checkout" class="mt-6 space-y-3">
      {carry.map((c) => <input type="hidden" name={c.name} value={c.value} />)}
      {showBuyerFields && <div class="space-y-3 rounded-lg border border-line bg-surface p-4">
        <p class="text-sm font-medium">购买信息</p>
        {buyerFields.email && <label class="block text-sm"><span class="mb-1 block text-muted">邮箱</span><input type="email" name="email" required autocomplete="email" class="w-full rounded-md border border-line px-3 py-2" placeholder="用于接收订单和数字商品" /></label>}
        {buyerFields.name && <label class="block text-sm"><span class="mb-1 block text-muted">姓名</span><input type="text" name="name" required autocomplete="name" class="w-full rounded-md border border-line px-3 py-2" /></label>}
        {buyerFields.virtualRegion && <label class="block text-sm"><span class="mb-1 block text-muted">虚拟地区</span><input type="text" name="virtual_region" required class="w-full rounded-md border border-line px-3 py-2" placeholder="例如：香港、美国、日本" /></label>}
      </div>}
      {destination.showSelect && <label class="flex items-center justify-between gap-2 text-xs uppercase tracking-widest text-muted">配送国家/地区<select name="country" class="rounded-md border border-line px-2 py-1.5 text-sm normal-case tracking-normal text-ink">{destination.countries.map((c) => <option value={c} selected={c === destination.defaultCountry}>{destination.label(c)}</option>)}</select></label>}
      {destination.hiddenOnly && <input type="hidden" name="country" value={destination.countries[0]} />}
      <CheckoutTurnstile />
      <div class="space-y-2">{methods.map((m, i) => {
      const stablecoinAddressStep = (m === 'usdc' || m === 'usdt') && stablecoinNeedsAddress;
      return <button type="submit" name="method" value={m} formaction={stablecoinAddressStep ? '/checkout' : '/api/checkout'} formmethod={stablecoinAddressStep ? 'GET' : 'POST'} class={`flex w-full items-center justify-between gap-3 rounded-lg px-5 py-3 text-left transition ${i === 0 ? 'bg-brand text-on-brand hover:bg-brand-hover' : 'border border-line text-muted hover:border-brand'}`}><span><span class="flex flex-wrap items-center gap-2 text-sm font-medium">{METHOD[m]?.label ?? m}{m === 'usdc' && <span class={`rounded-full px-2 py-0.5 text-[10px] font-medium ${i === 0 ? 'bg-on-brand/15 text-on-brand' : 'bg-brand/10 text-brand'}`}>推荐</span>}</span><span class={`block text-xs ${i === 0 ? 'text-on-brand/70' : 'text-muted'}`}>{METHOD[m]?.hint ?? ''}</span></span><span aria-hidden="true" class={i === 0 ? 'text-on-brand/80' : 'text-faint'}>&rarr;</span></button>;
    })}</div>
    </form>
    <a href={backHref} class="mt-6 inline-block text-xs uppercase tracking-widest text-faint hover:text-brand">&larr; 返回</a>
  </div>
</Layout>
