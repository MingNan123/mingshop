---
export const prerender = false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getStoreSettings } from '../../features/settings/db';
import { setSecret, vaultReady } from '../../features/secrets/store';
import {
  loadStablecoinProfiles,
  parseStablecoinProfiles,
  saveStablecoinProfiles,
  type StablecoinNetworkProfile,
} from '../../features/payments/stablecoin-networks';
import { CACHE_TAG } from '../../features/cache/tags';
import { purgeCacheTags } from '../../features/cache/purge';

const SLOT_COUNT = 8;
const TRON_USDT_CONTRACT = 'TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t';
const TRONGRID_MAINNET = 'https://api.trongrid.io';
const before = await getStoreSettings(env.DB);
const hadTronGridKey = before.configuredSecrets.includes('trongrid_api_key');

let profiles = await loadStablecoinProfiles(env.DB);
let saved = false;
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const clean = (name: string) => String(form.get(name) ?? '').trim();
  const parsed: StablecoinNetworkProfile[] = [];

  for (let i = 0; i < SLOT_COUNT; i++) {
    const prefix = `profile_${i}_`;
    const label = clean(`${prefix}label`);
    const receiveAddress = clean(`${prefix}receive_address`);
    const endpoint = clean(`${prefix}endpoint`);
    const tokenAddress = clean(`${prefix}token_address`);
    const hasAny = !!(label || receiveAddress || endpoint || tokenAddress);
    if (!hasAny) continue;

    const candidate = {
      id: clean(`${prefix}id`) || `network-${i + 1}`,
      token: clean(`${prefix}token`) === 'usdc' ? 'usdc' : 'usdt',
      label,
      kind: clean(`${prefix}kind`) === 'tron' ? 'tron' : 'evm',
      enabled: form.get(`${prefix}enabled`) === '1',
      receiveAddress,
      endpoint,
      tokenAddress,
      decimals: Number(clean(`${prefix}decimals`) || '6'),
      confirmations: Number(clean(`${prefix}confirmations`) || '12'),
    };
    const one = parseStablecoinProfiles(JSON.stringify([candidate]));
    if (one.length !== 1) {
      error = `网络配置 ${i + 1} 无效：请检查币种、网络类型、HTTPS 节点、收款地址、代币合约、decimals 和确认数。`;
      break;
    }
    parsed.push(one[0]);
  }

  const tronGridKey = clean('trongrid_api_key');
  const clearTronGridKey = clean('clear_trongrid_api_key') === '1';
  if (!error) {
    const officialTronGridNeeded = parsed.some((p) => {
      if (!p.enabled || p.kind !== 'tron') return false;
      try { return new URL(p.endpoint).host.toLowerCase() === 'api.trongrid.io'; } catch { return false; }
    });
    const willHaveKey = !clearTronGridKey && (!!tronGridKey || hadTronGridKey);
    if (officialTronGridNeeded && !willHaveKey) error = '启用官方 TronGrid 的 TRON 网络前，需要配置 TronGrid API Key。';
    else if ((tronGridKey || clearTronGridKey) && !vaultReady()) error = '修改 TronGrid API Key 前，需要先配置 SECRETS_KEK。';
  }

  if (!error) {
    try {
      await saveStablecoinProfiles(env.DB, parsed);
      if (clearTronGridKey) await setSecret(env.DB, 'trongrid_api_key', null);
      else if (tronGridKey) await setSecret(env.DB, 'trongrid_api_key', tronGridKey);
      // A profile may keep its ID while its chain/address changes. Reset cursors so
      // the watcher starts from the active pending-order window on the new config.
      await env.DB.prepare("DELETE FROM settings WHERE key LIKE 'stablecoin_cursor_%'").run();
      await purgeCacheTags([CACHE_TAG.shell, CACHE_TAG.catalog]);
      profiles = parsed;
      saved = true;
    } catch (err) {
      error = err instanceof Error ? err.message : '保存稳定币网络失败。';
    }
  }
}

const settings = await getStoreSettings(env.DB);
const tronGridKeyConfigured = settings.configuredSecrets.includes('trongrid_api_key');
const defaults: StablecoinNetworkProfile[] = [
  { id: 'network-1', token: 'usdc', label: '', kind: 'evm', enabled: false, receiveAddress: '', endpoint: '', tokenAddress: '', decimals: 6, confirmations: 12 },
  { id: 'network-2', token: 'usdc', label: '', kind: 'evm', enabled: false, receiveAddress: '', endpoint: '', tokenAddress: '', decimals: 6, confirmations: 12 },
  { id: 'network-3', token: 'usdc', label: '', kind: 'evm', enabled: false, receiveAddress: '', endpoint: '', tokenAddress: '', decimals: 6, confirmations: 12 },
  { id: 'network-4', token: 'usdt', label: 'TRON (TRC-20)', kind: 'tron', enabled: false, receiveAddress: '', endpoint: TRONGRID_MAINNET, tokenAddress: TRON_USDT_CONTRACT, decimals: 6, confirmations: 1 },
  { id: 'network-5', token: 'usdt', label: '', kind: 'evm', enabled: false, receiveAddress: '', endpoint: '', tokenAddress: '', decimals: 6, confirmations: 12 },
  { id: 'network-6', token: 'usdt', label: '', kind: 'evm', enabled: false, receiveAddress: '', endpoint: '', tokenAddress: '', decimals: 6, confirmations: 12 },
  { id: 'network-7', token: 'usdt', label: '', kind: 'evm', enabled: false, receiveAddress: '', endpoint: '', tokenAddress: '', decimals: 6, confirmations: 12 },
  { id: 'network-8', token: 'usdc', label: '', kind: 'evm', enabled: false, receiveAddress: '', endpoint: '', tokenAddress: '', decimals: 6, confirmations: 12 },
];
const slots = Array.from({ length: SLOT_COUNT }, (_, i) => profiles[i] ?? defaults[i]);
const enabledUsdc = profiles.filter((p) => p.enabled && p.token === 'usdc').length;
const enabledUsdt = profiles.filter((p) => p.enabled && p.token === 'usdt').length;
---

<AdminLayout title="稳定币网络">
  <div class="mx-auto max-w-4xl space-y-6">
    <div>
      <h1 class="text-2xl font-semibold">USDC / USDT 网络设置</h1>
      <p class="mt-2 text-sm text-muted">新订单只接受 USDC 和 USDT。你在这里启用可接受网络；买家付款时只能从你启用的同币种网络中选择，选定后该订单会冻结网络配置，双方始终保持一致。</p>
      <p class="mt-2 text-xs text-muted">当前已启用：USDC {enabledUsdc} 个网络 · USDT {enabledUsdt} 个网络。</p>
    </div>

    {saved && <div class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">网络设置已保存。新订单立即使用新的可选网络列表；旧待付款订单保持创建时的网络快照。</div>}
    {error && <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">{error}</div>}

    <form method="POST" class="space-y-5">
      <section class="rounded-lg border border-line bg-surface p-5">
        <h2 class="text-lg font-medium">TRON API Key</h2>
        <p class="mt-1 text-xs text-muted">只有启用官方 api.trongrid.io 的 TRON 网络时需要。密钥使用项目 Secret Vault 加密保存，不会回显，也不会发送给自定义第三方 API。</p>
        <input name="trongrid_api_key" type="password" autocomplete="new-password" placeholder={tronGridKeyConfigured ? '已配置；留空保持不变' : 'TRON-PRO-API-KEY'} class="mt-3 w-full rounded-md border border-line px-3 py-2 font-mono text-xs" />
        {tronGridKeyConfigured && <label class="mt-2 flex items-center gap-2 text-xs text-muted"><input type="checkbox" name="clear_trongrid_api_key" value="1" />清除已保存的 TronGrid API Key</label>}
      </section>

      {slots.map((profile, i) => (
        <section class="rounded-lg border border-line bg-surface p-5 space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div><h2 class="text-lg font-medium">收款网络 {i + 1}</h2><p class="text-xs text-muted">买家看到的网络必须来自这里的“已启用”配置。</p></div>
            <label class="flex items-center gap-2 text-sm font-medium"><input type="checkbox" name={`profile_${i}_enabled`} value="1" checked={profile.enabled} />启用给买家</label>
          </div>
          <input type="hidden" name={`profile_${i}_id`} value={profile.id} />
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block text-sm"><span class="mb-1 block font-medium">币种</span><select name={`profile_${i}_token`} class="w-full rounded-md border border-line px-3 py-2"><option value="usdt" selected={profile.token === 'usdt'}>USDT</option><option value="usdc" selected={profile.token === 'usdc'}>USDC</option></select></label>
            <label class="block text-sm"><span class="mb-1 block font-medium">链类型</span><select name={`profile_${i}_kind`} class="w-full rounded-md border border-line px-3 py-2"><option value="evm" selected={profile.kind === 'evm'}>EVM / ERC-20</option><option value="tron" selected={profile.kind === 'tron'}>TRON / TRC-20（仅 USDT）</option></select></label>
            <label class="block text-sm sm:col-span-2"><span class="mb-1 block font-medium">买家看到的网络名称</span><input name={`profile_${i}_label`} value={profile.label} placeholder="例如 Base / Polygon / TRON (TRC-20)" class="w-full rounded-md border border-line px-3 py-2" /></label>
            <label class="block text-sm sm:col-span-2"><span class="mb-1 block font-medium">你的收款地址</span><input name={`profile_${i}_receive_address`} value={profile.receiveAddress} placeholder={profile.kind === 'tron' ? 'T...' : '0x...'} class="w-full rounded-md border border-line px-3 py-2 font-mono text-xs" /></label>
            <label class="block text-sm sm:col-span-2"><span class="mb-1 block font-medium">RPC / 链上查询 API</span><input name={`profile_${i}_endpoint`} value={profile.endpoint} placeholder={profile.kind === 'tron' ? TRONGRID_MAINNET : 'https://...'} class="w-full rounded-md border border-line px-3 py-2 font-mono text-xs" /></label>
            <label class="block text-sm sm:col-span-2"><span class="mb-1 block font-medium">该网络的官方 USDC / USDT 合约</span><input name={`profile_${i}_token_address`} value={profile.tokenAddress} placeholder={profile.kind === 'tron' ? 'T...' : '0x...'} class="w-full rounded-md border border-line px-3 py-2 font-mono text-xs" /></label>
            <label class="block text-sm"><span class="mb-1 block font-medium">Decimals</span><input name={`profile_${i}_decimals`} type="number" min="2" max="18" value={profile.decimals} class="w-full rounded-md border border-line px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-medium">确认数</span><input name={`profile_${i}_confirmations`} type="number" min="1" max="200" value={profile.confirmations} class="w-full rounded-md border border-line px-3 py-2" /></label>
          </div>
        </section>
      ))}

      <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">只启用你已经核对过的网络、公开收款地址和官方代币合约。不要填写私钥或助记词。TRON 类型只能用于 USDT；USDC 使用 EVM 网络配置。</div>
      <button type="submit" class="rounded-md bg-brand px-5 py-2.5 text-sm font-medium text-on-brand hover:bg-brand-hover">保存可接受网络</button>
    </form>
  </div>
</AdminLayout>
