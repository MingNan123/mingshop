---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ProductForm from '../../../features/products/ProductForm.astro';
import { listCategories, buildTree, flattenTree } from '../../../features/categories/db';
import { zonesRequireWeight } from '../../../features/shipping/calculator';
import { shippingFor } from '../../../features/shipping/effective';

const categoryOptions = flattenTree(buildTree(await listCategories(env.DB)));
const error = Astro.url.searchParams.get('error');
const weightUnit = Astro.locals.settings?.weightUnit ?? 'g';
const weightRequired = zonesRequireWeight(shippingFor(Astro.locals.settings).config);
---

<AdminLayout title="新建商品" active="products">
  <a href="/admin/products" class="text-sm text-gray-500 hover:text-brand">&larr; 返回商品列表</a>
  <h1 class="mt-4 mb-6 text-2xl font-bold">新建商品</h1>
  <ProductForm action="/api/admin/products" submitLabel="创建商品" categoryOptions={categoryOptions} error={error} weightUnit={weightUnit} weightRequired={weightRequired} />
</AdminLayout>
