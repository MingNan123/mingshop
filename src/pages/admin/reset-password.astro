---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { adminCredential, setAdminPassword, adminPasswordHash } from '../../features/auth/admin';
import { verifyAdminResetToken } from '../../features/auth/adminReset';
import { signSession } from '../../features/auth/session';

const MIN_PASSWORD = 8;
const SESSION_TTL = 7 * 24 * 3600;
const token = Astro.url.searchParams.get('token') ?? '';
const cred = await adminCredential(env.DB);
if (!cred.enabled) return Astro.redirect('/admin/setup', 303);
const signingKey = env.AUTH_SECRET || cred.tagSource;
let valid = await verifyAdminResetToken(token, signingKey, cred.tagSource, Date.now() / 1000);
let error = '';

if (Astro.request.method === 'POST' && valid) {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  const confirmation = String(form.get('password_confirmation') ?? '');
  if (password.length < MIN_PASSWORD) error = `密码至少需要 ${MIN_PASSWORD} 个字符。`;
  else if (password !== confirmation) error = '两次输入的密码不一致。';
  else {
    // Verify again immediately before the write to narrow the time-of-check window.
    valid = await verifyAdminResetToken(token, signingKey, cred.tagSource, Date.now() / 1000);
    if (valid) {
      await setAdminPassword(env.DB, password);
      const hash = (await adminPasswordHash(env.DB))!;
      const newSigningKey = env.AUTH_SECRET || hash;
      const session = await signSession(newSigningKey, hash, SESSION_TTL, Date.now() / 1000);
      Astro.cookies.set('admin_session', session, { httpOnly: true, secure: Astro.url.protocol === 'https:', sameSite: 'lax', path: '/', maxAge: SESSION_TTL });
      return Astro.redirect('/admin?msg=password-reset', 303);
    }
  }
}
---

<Layout title="重置后台密码">
  <div class="mx-auto max-w-sm py-10">
    <h1 class="mb-6 text-2xl font-bold">重置后台密码</h1>
    {!valid ? (
      <div class="space-y-4">
        <p class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">该重置链接无效或已过期，请重新申请。</p>
        <a href="/admin/forgot-password" class="inline-block text-sm text-accent hover:underline">重新发送邮件</a>
      </div>
    ) : (
      <form method="POST" action={`/admin/reset-password?token=${encodeURIComponent(token)}`} class="space-y-4">
        {error && <p class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{error}</p>}
        <label class="block text-sm"><span class="mb-1 block font-medium">新密码</span><input type="password" name="password" required autofocus minlength={MIN_PASSWORD} autocomplete="new-password" class="w-full rounded-md border border-gray-200 px-3 py-2" /></label>
        <label class="block text-sm"><span class="mb-1 block font-medium">确认新密码</span><input type="password" name="password_confirmation" required minlength={MIN_PASSWORD} autocomplete="new-password" class="w-full rounded-md border border-gray-200 px-3 py-2" /></label>
        <button type="submit" class="w-full rounded-md bg-brand px-4 py-2.5 font-medium text-white hover:bg-brand-hover">保存新密码</button>
      </form>
    )}
  </div>
</Layout>
