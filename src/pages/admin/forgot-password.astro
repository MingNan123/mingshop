---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import Turnstile from '../../features/auth/Turnstile.astro';
import { TURNSTILE_FIELD, verifyConfiguredTurnstile } from '../../features/auth/turnstile';
import { adminCredential } from '../../features/auth/admin';
import { signAdminResetToken } from '../../features/auth/adminReset';
import { getEmailProvider } from '../../features/email';
import { adminPasswordResetEmail } from '../../features/email/adminPasswordReset';
import { parseEmailRecipients } from '../../features/email/recipients';
import { getSecret } from '../../features/secrets/store';
import { getStoreSettings } from '../../features/settings/db';
import { getConfig } from '../../config';

const cred = await adminCredential(env.DB);
if (!cred.enabled) return Astro.redirect('/admin/setup', 303);

let sent = false;
let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const settings = await getStoreSettings(env.DB);
  const turnstileEnabled = settings.turnstileEnabled;
  const tsSecret = turnstileEnabled
    ? (env.TURNSTILE_SECRET || await getSecret(env.DB, 'turnstile_secret_key'))
    : null;
  const tsOk = await verifyConfiguredTurnstile(
    turnstileEnabled,
    form.get(TURNSTILE_FIELD)?.toString(),
    tsSecret,
    Astro.request.headers.get('CF-Connecting-IP'),
  );
  if (!tsOk) {
    error = '验证失败，请重试。';
  } else {
    const typedEmail = String(form.get('email') ?? '').trim().toLowerCase();
    // Existing shops already have owner notification recipients. Use the first
    // one as a safe migration fallback until a dedicated recovery address is saved.
    const recoveryEmail = (
      settings.adminRecoveryEmail ?? parseEmailRecipients(settings.emailNotifyTo)[0]
    )?.trim().toLowerCase();
    if (recoveryEmail && typedEmail === recoveryEmail) {
      const provider = await getEmailProvider(settings);
      if (provider) {
        const signingKey = env.AUTH_SECRET || cred.tagSource;
        const token = await signAdminResetToken(signingKey, cred.tagSource, 15 * 60, Date.now() / 1000);
        const link = new URL(`/admin/reset-password?token=${encodeURIComponent(token)}`, Astro.url.origin).toString();
        try {
          await provider.send(adminPasswordResetEmail(recoveryEmail, link, settings.storeName ?? getConfig().storeName));
        } catch (cause) {
          console.error('Admin password reset email failed:', cause);
        }
      }
    }
    // The same response for every address prevents disclosure of the configured admin email.
    sent = true;
  }
}
---

<Layout title="找回后台密码">
  <div class="mx-auto max-w-sm py-10">
    <h1 class="mb-2 text-2xl font-bold">找回后台密码</h1>
    {sent ? (
      <div class="space-y-4">
        <p class="rounded-md border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-800">如果该邮箱与管理员找回邮箱一致，我们已发送一封重置邮件。请在 15 分钟内打开链接。</p>
        <a href="/admin/login" class="inline-block text-sm text-accent hover:underline">返回登录</a>
      </div>
    ) : (
      <>
        <p class="mb-6 text-sm text-gray-500">输入后台设置中保存的管理员找回邮箱。</p>
        {error && <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{error}</p>}
        <form method="POST" action="/admin/forgot-password" class="space-y-4">
          <label class="block text-sm"><span class="mb-1 block font-medium">邮箱</span><input type="email" name="email" required autofocus autocomplete="email" class="w-full rounded-md border border-gray-200 px-3 py-2" /></label>
          <div class="flex justify-center"><Turnstile /></div>
          <button type="submit" class="w-full rounded-md bg-brand px-4 py-2.5 font-medium text-white hover:bg-brand-hover">发送重置邮件</button>
          <p class="text-center text-sm"><a href="/admin/login" class="text-accent hover:underline">返回登录</a></p>
        </form>
      </>
    )}
  </div>
</Layout>
