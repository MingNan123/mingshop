---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Pagination from '../../../components/Pagination.astro';
import { MEDIA_PAGE_SIZE, countMedia } from '../../../features/media/db';
import { isUnused, usageLinks } from '../../../features/media/usage';
import { mediaUrl } from '../../../features/media/url';
import { loadMediaPage } from '../../api/admin/media';
import { paginate, queryHref } from '../../../pagination';

const error = Astro.url.searchParams.get('error');
const total = await countMedia(env.DB);
const { page, offset, totalPages } = paginate(Astro.url.searchParams, total, MEDIA_PAGE_SIZE);
const { items, usage, baseUrl } = await loadMediaPage(MEDIA_PAGE_SIZE, offset);
const hrefFor = (p: number) => queryHref('/admin/media', { page: p > 1 ? p : undefined });
const dateFmt = new Intl.DateTimeFormat('zh-CN', { dateStyle: 'medium' });
const formatDate = (iso: string) => dateFmt.format(new Date(`${iso.replace(' ', 'T')}Z`));
function formatSize(bytes: number | null): string | null {
  if (bytes == null) return null;
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${Math.round(bytes / 1024)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}
---

<AdminLayout title="媒体库" active="media">
  <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="font-serif text-3xl tracking-tight">媒体库</h1>
      <p class="mt-1 text-sm text-gray-500">共 {total} 个文件。删除后会从所有使用位置移除；只要仍在使用中就无法删除。</p>
    </div>
  </div>

  {error && <p class="mb-6 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">{error}</p>}

  <form method="post" action="/api/admin/media" enctype="multipart/form-data" class="mb-8 flex flex-wrap items-center gap-3 rounded-md border border-line p-4">
    <input type="file" name="files" accept="image/jpeg,image/png,image/webp,image/gif" multiple required class="block w-full text-sm text-gray-600 file:mr-3 file:cursor-pointer file:rounded-md file:border-0 file:bg-brand file:px-4 file:py-2 file:text-xs file:font-medium file:uppercase file:tracking-wider file:text-white hover:file:bg-brand-hover" />
    <button type="submit" class="rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover">上传</button>
    <span class="text-xs text-gray-500">支持 JPEG、PNG、WebP、GIF，单个文件最大 5 MB。</span>
  </form>

  {items.length === 0 ? (
    <p class="py-12 text-center text-sm text-gray-500">暂无文件。可以从上方上传，或在商品中添加图片；所有上传文件都会出现在这里。</p>
  ) : (
    <ul class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
      {items.map((m) => {
        const entry = usage.get(m.id);
        const unused = !!entry && isUnused(entry);
        const size = formatSize(m.size_bytes);
        const dimensions = m.width && m.height ? `${m.width} × ${m.height}` : null;
        const url = mediaUrl(m.image_key, baseUrl);
        return (
          <li class="flex flex-col gap-2">
            <div class="aspect-square overflow-hidden rounded-md border border-line bg-gray-50"><img src={url} alt={m.original_name} loading="lazy" decoding="async" class="h-full w-full object-contain" /></div>
            <p class="truncate text-sm" title={m.original_name}>{m.original_name}</p>
            <p class="text-xs text-gray-500">{formatDate(m.created_at)}{dimensions ? ` · ${dimensions}` : ''}{size ? ` · ${size}` : ''}{!m.mime_type && !size ? ' · 旧版图片' : ''}</p>
            <p class="text-xs text-gray-600">
              {unused ? <span class="text-gray-400">未使用</span> : <Fragment>使用位置：{' '}{usageLinks(entry!).map((link, index) => <Fragment>{index > 0 && '、'}<a href={link.href} title={link.title} class="underline decoration-gray-300 underline-offset-2 hover:text-brand">{link.label}</a></Fragment>)}</Fragment>}
            </p>
            <div class="mt-auto flex items-center gap-3 pt-1">
              <button type="button" data-copy-url={url} class="text-xs uppercase tracking-widest text-gray-500 hover:text-brand">复制链接</button>
              {unused && <form method="post" action={`/api/admin/media/${m.public_id}`}><input type="hidden" name="_action" value="delete" /><button type="submit" class="text-xs uppercase tracking-widest text-red-600 hover:text-red-700">删除</button></form>}
            </div>
          </li>
        );
      })}
    </ul>
  )}

  <Pagination page={page} totalPages={totalPages} hrefFor={hrefFor} />
</AdminLayout>

<script>
  document.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement)?.closest<HTMLElement>('[data-copy-url]');
    if (!button) return;
    const url = new URL(button.dataset.copyUrl!, location.origin).href;
    try {
      await navigator.clipboard.writeText(url);
      const original = button.textContent;
      button.textContent = '已复制';
      setTimeout(() => { button.textContent = original; }, 1200);
    } catch {}
  });
</script>
