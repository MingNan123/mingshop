---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { formatPrice, getConfig } from '../../config';
import { countAllProducts, lowStockProducts } from '../../features/products/db';
import { listOrders, orderStats, dailyOrderTotals,countOrders } from '../../features/orders/db';
import {liveOrderFilter} from '../../features/orders/live';
import WaffoPaymentSummary from '../../components/WaffoPaymentSummary.astro';
import { countCustomers } from '../../features/customers/db';
import { orderReference } from '../../features/orders/number';
import RevenueChart from '../../components/RevenueChart.astro';

if (!Astro.locals.settings?.setupComplete) return Astro.redirect('/admin/setup', 302);

const liveFilter=liveOrderFilter({where:'',params:[]});
const currency=getConfig().currency.toUpperCase();
const currencyFilter={where:`${liveFilter.where} AND UPPER(currency)=? AND status!='pending'`,params:[currency]};
const stats = await orderStats(env.DB,currencyFilter);
const liveCount=await countOrders(env.DB,liveFilter);
const productCount = await countAllProducts(env.DB);
const customerCount = await countCustomers(env.DB,false);
const daily = await dailyOrderTotals(env.DB, 14,currencyFilter);
const recent = await listOrders(env.DB, 5,'created_at DESC',0,liveFilter);
const lowStock = await lowStockProducts(env.DB, 5, 8);
const onCfg = getConfig().orderNumber;

const cards = [
  {
    label: `订单净额 · ${currency}`,
    value: formatPrice(stats.revenue_cents),
    sub: stats.refunded_cents > 0 ? `${formatPrice(stats.refunded_cents)} 已退款` : '订单原币金额，不含演示订单',
  },
  { label: '正式订单', value: String(liveCount), sub: null },
  { label: '商品', value: String(productCount), sub: null },
  { label: '客户', value: String(customerCount), sub: null },
];
---

<AdminLayout title="仪表盘" active="dashboard">
  <h1 class="mb-8 font-serif text-3xl tracking-tight">仪表盘</h1>

  <div class="mb-12 grid grid-cols-2 gap-4 sm:grid-cols-4">
    {cards.map((c) => (
      <div class="rounded-lg border border-line p-5">
        <p class="text-xs uppercase tracking-widest text-gray-400">{c.label}</p>
        <p class="mt-2 font-serif text-2xl tabular-nums">{c.value}</p>
        {c.sub && <p class="mt-1 text-xs tabular-nums text-gray-400">{c.sub}</p>}
      </div>
    ))}
  </div>

  <div class="mb-12 rounded-lg border border-line p-5">
    <RevenueChart data={daily} />
  </div>
  <WaffoPaymentSummary />

  <div class="grid gap-12 lg:grid-cols-2">
    <section>
      <div class="mb-3 flex items-baseline justify-between">
        <h2 class="text-xs uppercase tracking-widest text-gray-400">最近订单</h2>
        <a href="/admin/orders" class="text-xs uppercase tracking-widest text-accent hover:underline">查看全部</a>
      </div>
      <table class="w-full text-left text-sm">
        <tbody>
          {recent.map((o) => (
            <tr class="border-b border-line">
              <td class="py-2 pr-4"><a href={`/admin/orders/${o.public_id}`} class="text-accent tabular-nums hover:underline">#{orderReference(o.public_id, o.id, onCfg)}</a></td>
              <td class="py-2 pr-4 text-gray-500">{o.email ?? '—'}</td>
              <td class="py-2 text-right tabular-nums">{formatPrice(o.amount_total_cents, o.currency)}</td>
            </tr>
          ))}
          {recent.length === 0 && <tr><td class="py-6 text-center text-gray-400">暂无订单。</td></tr>}
        </tbody>
      </table>
    </section>

    <section>
      <div class="mb-3 flex items-baseline justify-between">
        <h2 class="text-xs uppercase tracking-widest text-gray-400">库存不足</h2>
        <a href="/admin/products?sort=stock&dir=asc" class="text-xs uppercase tracking-widest text-accent hover:underline">查看全部</a>
      </div>
      <table class="w-full text-left text-sm">
        <tbody>
          {lowStock.map((p) => (
            <tr class="border-b border-line">
              <td class="py-2 pr-4"><a href={`/admin/products/${p.public_id}/edit`} class="hover:text-brand">{p.name}</a></td>
              <td class="py-2 text-right tabular-nums"><span class={0 >= p.stock ? 'text-red-600' : 'text-amber-700'}>{p.stock} 件剩余</span></td>
            </tr>
          ))}
          {lowStock.length === 0 && <tr><td class="py-6 text-center text-gray-400">库存充足。</td></tr>}
        </tbody>
      </table>
    </section>
  </div>
</AdminLayout>
