---
import {env} from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import WaffoPaymentSummary from '../../components/WaffoPaymentSummary.astro';
import Pagination from '../../components/Pagination.astro';
import {formatPrice,formatDate,getConfig} from '../../config';
import {listMerchantPayments,countMerchantPayments} from '../../features/payments/waffoLedgerDb';
import {paginate,queryHref} from '../../pagination';
const successfulOnly=Astro.url.searchParams.get('status')!=='all';
const matchCount=await countMerchantPayments(env.DB,successfulOnly);
const {page,totalPages,offset}=paginate(Astro.url.searchParams,matchCount,50);
const {rows,count}=await listMerchantPayments(env.DB,50,offset,successfulOnly);
const timeZone=Astro.locals.settings?.timeZone??getConfig().timeZone;
const statusNames:Record<string,string>={succeeded:'付款成功',failed:'付款失败',pending:'等待付款',processing:'处理中',expired:'已过期',canceled:'已取消'};
const matchNames:Record<string,string>={matched:'核对一致',unmatched:'未匹配商店订单',amount_mismatch:'订单金额不一致',reference_mismatch:'交易编号不一致'};
const message=Astro.url.searchParams.get('message');
---
<AdminLayout title="交易对账" active="payments">
  <h1 class="mb-3 text-3xl font-semibold tracking-tight">交易对账</h1>
  <p class="mb-6 text-sm text-gray-500">直接读取 Waffo 商户平台的生产交易。失败和待付款交易不计入实付；USDC、支付宝等其他方式仍在订单页查看。</p>
  {message && <p class="mb-5 rounded-md border border-line p-3 text-sm" role="status">{message}</p>}
  <WaffoPaymentSummary />
  <div class="mb-3 flex flex-wrap justify-between gap-3 text-sm">
    <h2 class="font-semibold">{successfulOnly?'成功付款记录':'全部商户交易'} · {count} 笔</h2>
    <a class="text-accent hover:underline" href={successfulOnly?'/admin/payments?status=all':'/admin/payments'}>{successfulOnly?'查看全部交易（含失败和未付款）':'仅查看成功付款'}</a>
  </div>
  <div class="overflow-x-auto">
    <table class="admin-table w-full text-left text-sm">
      <thead><tr class="border-b border-line text-xs text-gray-500">
        <th class="p-3">时间</th><th class="p-3">商店订单</th><th class="p-3">Waffo 交易号</th>
        <th class="p-3">订单原币金额</th><th class="p-3">客户实付</th><th class="p-3">已退款</th><th class="p-3">付款状态</th><th class="p-3">核对结果</th>
      </tr></thead>
      <tbody>{rows.map(row=><tr class="border-b border-line">
        <td class="p-3 whitespace-nowrap">{formatDate(row.paid_at,undefined,timeZone)}</td>
        <td class="p-3">{row.local_public_id ? <a class="text-accent hover:underline" href={`/admin/orders/${row.local_public_id}`}>#{row.local_order_id}</a> : <span class="text-gray-500">{row.external_id??'—'}</span>}</td>
        <td class="p-3 font-mono text-xs" title={row.provider_order_id}>{row.payment_id}</td>
        <td class="p-3 tabular-nums whitespace-nowrap">{formatPrice(row.order_amount_minor,row.order_currency)} {row.order_currency}</td>
        <td class="p-3 tabular-nums whitespace-nowrap">{row.status==='succeeded' ? `${formatPrice(row.amount_minor,row.currency)} ${row.currency}` : '—'}</td>
        <td class="p-3 tabular-nums whitespace-nowrap">{row.status!=='succeeded' ? '—' : row.refunded_minor===null ? '待核对' : formatPrice(row.refunded_minor,row.currency)}</td>
        <td class="p-3 whitespace-nowrap">{statusNames[row.status]??row.status}</td>
        <td class:list={['p-3 whitespace-nowrap',row.status!=='succeeded'?'text-gray-500':row.match_status==='matched'?'text-green-700':'text-amber-800']}>{row.status!=='succeeded'?'未成功付款，无需入账':matchNames[row.match_status]??row.match_status}</td>
      </tr>)}</tbody>
    </table>
    {rows.length===0 && <p class="py-10 text-center text-gray-500">完成同步后，商户交易会显示在这里。</p>}
  </div>
  <Pagination page={page} totalPages={totalPages} hrefFor={(p:number)=>queryHref('/admin/payments',{status:successfulOnly?undefined:'all',page:p>1?p:undefined})} />
</AdminLayout>
