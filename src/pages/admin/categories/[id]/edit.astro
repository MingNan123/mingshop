---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import CategoryForm from '../../../../features/categories/CategoryForm.astro';
import {
  getCategoryByPublicId,
  listCategories,
  buildTree,
  flattenTree,
  descendantIds,
} from '../../../../features/categories/db';
import { parsePublicId } from '../../../../features/ids/publicId';

const publicId = parsePublicId(Astro.params.id, 'category');
const category = publicId ? await getCategoryByPublicId(env.DB, publicId) : null;

if (!category) {
  return new Response('未找到该分类', { status: 404 });
}

const blocked = new Set(await descendantIds(env.DB, category.id));
const parentOptions = flattenTree(buildTree(await listCategories(env.DB))).filter(
  (o) => !blocked.has(o.id),
);
const error = Astro.url.searchParams.get('error');
---

<AdminLayout title={`编辑${category.name}`} active="categories">
  <a href="/admin/categories" class="text-sm text-gray-500 hover:text-brand">&larr; 返回分类管理</a>
  <h1 class="mt-4 mb-2 text-2xl font-bold">编辑分类</h1>
  <p class="mb-6 text-sm text-gray-500">修改分类名称、链接标识或上级分类。</p>
  <CategoryForm
    action={`/api/admin/categories/${category.public_id}`}
    submitLabel="保存修改"
    category={category}
    parentOptions={parentOptions}
    error={error}
  />
</AdminLayout>
