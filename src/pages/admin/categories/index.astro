---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { menuReferencesFor } from '../../../features/navigation/admin';
import { listCategories, buildTree, flattenTree, productCounts } from '../../../features/categories/db';

const rows = flattenTree(buildTree(await listCategories(env.DB)));
const counts = await productCounts(env.DB);
const menuRefs = await menuReferencesFor(env.DB, 'category', rows.map((r) => r.id));
---

<AdminLayout title="分类" active="categories">
  <div class="mb-8 flex items-center justify-between">
    <h1 class="font-serif text-3xl tracking-tight">分类</h1>
    <a href="/admin/categories/new" class="rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover">新建分类</a>
  </div>

  <div class="sm:overflow-x-auto">
    <table class="admin-table w-full text-left text-sm sm:min-w-[40rem]">
      <thead><tr class="border-b border-line text-xs uppercase tracking-widest text-gray-400">
        <th class="py-3 pr-4 font-normal">名称</th>
        <th class="py-3 pr-4 font-normal">链接标识</th>
        <th class="py-3 pr-4 font-normal">商品数量</th>
        <th class="py-3 text-right font-normal">操作</th>
      </tr></thead>
      <tbody>
        {rows.map((c) => (
          <tr class="border-b border-line">
            <td class="py-3 pr-4"><a href={`/admin/categories/${c.public_id}/edit`} class="inline-block font-medium hover:text-brand" style={`padding-left:${c.depth * 20}px`}>{c.depth > 0 && <span class="text-gray-400">↳ </span>}{c.name}</a></td>
            <td data-label="链接标识" class="py-3 pr-4 text-gray-500">{c.slug}</td>
            <td data-label="商品数量" class="py-3 pr-4 tabular-nums text-gray-500">{counts.get(c.id) ?? 0}</td>
            <td data-label="操作" class="py-3 text-right"><div class="flex justify-end gap-4 text-xs uppercase tracking-widest">
              <a href={`/admin/categories/${c.public_id}/edit`} class="text-accent hover:underline">编辑</a>
              <form method="POST" action={`/api/admin/categories/${c.public_id}`} onsubmit={`return confirm('${menuRefs.has(c.id) ? '该分类已关联到商城导航。删除后该导航链接将隐藏，子分类会移动到当前分类的上级。确定继续吗？' : '确定删除该分类吗？子分类会移动到当前分类的上级。'}')`}>
                <input type="hidden" name="_action" value="delete" />
                <button type="submit" class="text-red-600 hover:underline">删除</button>
              </form>
            </div></td>
          </tr>
        ))}
        {rows.length === 0 && <tr><td colspan="4" class="py-8 text-center text-gray-400">暂无分类。</td></tr>}
      </tbody>
    </table>
  </div>
</AdminLayout>
