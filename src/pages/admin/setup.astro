---
export const prerender = false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getConfig } from '../../config';
import { setSetting, getSetting, getStoreSettings } from '../../features/settings/db';
import { normalizeTimeZone, allTimeZones } from '../../features/settings/timeZone';
import { setAdminPassword, adminPasswordHash } from '../../features/auth/admin';
import { signSession } from '../../features/auth/session';
import { catalogIsEmpty, seedDemoCatalog } from '../../features/seed/demo';
import { CACHE_TAG } from '../../features/cache/tags';
import { purgeCacheTags } from '../../features/cache/purge';

const cfg = getConfig();
const SESSION_TTL = 7 * 24 * 3600;
const MIN_PW = 8;
let timeZoneError = '';
let passwordError = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const name = String(form.get('store_name') ?? '').trim();
  const tz = normalizeTimeZone(String(form.get('time_zone') ?? ''));
  const pw = String(form.get('admin_password') ?? '');
  const hasPasswordAlready = !!(await getSetting(env.DB, 'admin_password_hash'));
  const behindAccess = !!Astro.locals.adminEmail;
  if (!tz) timeZoneError = '请输入有效的 IANA 时区，例如 UTC 或 Asia/Shanghai。';
  if (pw && pw.length < MIN_PW) passwordError = `密码至少需要 ${MIN_PW} 个字符。`;
  const willHaveCredential = hasPasswordAlready || behindAccess || pw.length >= MIN_PW;
  if (!import.meta.env.DEV && !willHaveCredential && !passwordError) passwordError = '请设置管理员密码，否则无法进入后台。';
  if (!timeZoneError && !passwordError) {
    await setSetting(env.DB, 'store_name', name || null);
    await setSetting(env.DB, 'time_zone', tz!);
    if (pw) {
      await setAdminPassword(env.DB, pw);
      const hash = (await adminPasswordHash(env.DB))!;
      const signingKey = env.AUTH_SECRET || hash;
      const token = await signSession(signingKey, hash, SESSION_TTL, Date.now() / 1000);
      Astro.cookies.set('admin_session', token, { httpOnly: true, secure: Astro.url.protocol === 'https:', sameSite: 'lax', path: '/', maxAge: SESSION_TTL });
    }
    if (form.get('seed_demo') === 'on' && (await catalogIsEmpty(env.DB))) {
      try { await seedDemoCatalog(env.DB); } catch (err) { console.error('Demo catalog seed failed:', err); }
    }
    await setSetting(env.DB, 'setup_complete', '1');
    await purgeCacheTags([CACHE_TAG.shell, CACHE_TAG.catalog]);
    return Astro.redirect('/admin?msg=setup-complete', 303);
  }
}

const settings = await getStoreSettings(env.DB);
const storeName = settings.storeName ?? cfg.storeName;
const timeZone = settings.timeZone ?? cfg.timeZone;
const timeZones = allTimeZones();
const hasPassword = !!(await getSetting(env.DB, 'admin_password_hash'));
const catalogEmpty = await catalogIsEmpty(env.DB);
---

<AdminLayout title="首次设置" active="dashboard">
  <div class="mx-auto max-w-2xl">
    <h1 class="text-2xl font-bold">设置你的商城</h1>
    <p class="mt-1 text-sm text-gray-500">完成首次设置后即可开始使用。之后可以随时在「设置」中修改。</p>

    <form method="POST" class="mt-8 space-y-6">
      <section class="rounded-lg border border-line bg-white p-5">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-gray-500">商城基本信息</h2>
        <div class="mt-4 flex flex-wrap items-end gap-3">
          <label class="flex flex-col gap-1 text-xs uppercase tracking-widest text-gray-400">商城名称<input type="text" name="store_name" value={storeName} class="w-64 rounded-md border border-gray-300 px-3 py-2 text-sm normal-case tracking-normal focus:border-brand focus:outline-none" /></label>
          <label class="flex flex-col gap-1 text-xs uppercase tracking-widest text-gray-400">商城时区<input type="text" name="time_zone" value={timeZone} required list="tz-list" data-time-zone data-auto-detect={settings.timeZone ? 'false' : 'true'} placeholder="例如 Asia/Shanghai" class="w-64 rounded-md border border-gray-300 px-3 py-2 text-sm normal-case tracking-normal focus:border-brand focus:outline-none" /><datalist id="tz-list">{timeZones.map((z) => <option value={z} />)}</datalist></label>
        </div>
        {timeZoneError && <p class="mt-2 text-xs text-red-600">{timeZoneError}</p>}
        <p class="mt-3 text-xs text-gray-400">货币为构建时设置，请在 <code class="rounded bg-gray-100 px-1">src/config.ts</code> 中配置 <code class="rounded bg-gray-100 px-1">currency</code>。当前：{cfg.currency.toUpperCase()}。</p>
      </section>

      <section class="rounded-lg border border-line bg-white p-5">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-gray-500">管理员密码</h2>
        <p class="mt-1 text-sm text-gray-500">用于 <code class="rounded bg-gray-100 px-1">/admin/login</code> 登录。密码经过 PBKDF2 哈希后存储，不保存明文。{hasPassword ? ' 已设置密码；留空可保持不变。' : ' 完成设置时必须填写。'}</p>
        <label class="mt-4 flex flex-col gap-1 text-xs uppercase tracking-widest text-gray-400">{hasPassword ? '新密码（可选）' : '管理员密码'}<input type="password" name="admin_password" autocomplete="new-password" minlength="8" placeholder="至少 8 个字符" class="w-64 rounded-md border border-gray-300 px-3 py-2 text-sm normal-case tracking-normal focus:border-brand focus:outline-none" /></label>
        {passwordError && <p class="mt-2 text-xs text-red-600">{passwordError}</p>}
      </section>

      <section class="rounded-lg border border-line bg-white p-5">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-gray-500">支付设置</h2>
        <p class="mt-2 text-sm text-gray-500"><strong>演示结账</strong>可以立即使用。真实支付方式可以稍后在「设置 → 支付」中配置，例如银行卡、Bitcoin Lightning 或 OpenNode。</p>
      </section>

      {catalogEmpty && <label class="flex items-start gap-2 text-sm text-gray-600"><input type="checkbox" name="seed_demo" class="mt-0.5 rounded border-gray-300 text-brand focus:ring-brand" /><span>加载<strong>演示商品目录</strong>——包含 6 个分类、30 个示例商品，用于体验商城。取消勾选则从空商城开始。</span></label>}
      <button type="submit" class="w-fit rounded-md bg-brand px-5 py-2.5 text-sm font-medium text-white hover:bg-brand-hover">完成设置</button>
    </form>
  </div>
  <script>
    const input = document.querySelector<HTMLInputElement>('[data-time-zone]');
    if (input?.dataset.autoDetect === 'true') { const detected = Intl.DateTimeFormat().resolvedOptions().timeZone; if (detected) input.value = detected; }
  </script>
</AdminLayout>
