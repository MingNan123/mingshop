---
import { getConfig } from '../config';
import { paymentsInDemoMode } from '../features/payments';
import { shippingFor } from '../features/shipping/effective';
import { env } from 'cloudflare:workers';
import { countUnresolvedInventoryExceptions } from '../features/orders/db';
import '../styles/admin.css';

type Section =
  | 'dashboard'
  | 'products'
  | 'orders'
  | 'customers'
  | 'categories'
  | 'media'
  | 'pages'
  | 'navigation'
  | 'shipping'
  | 'settings';

interface Props {
  title?: string;
  active?: Section;
}

const { title, active } = Astro.props;
const config = getConfig();
const storeName = Astro.locals.settings?.storeName ?? config.storeName;
const showSetupNudge = !Astro.locals.settings?.setupComplete && Astro.url.pathname !== '/admin/setup';
const showLogout = !!Astro.cookies.get('admin_session')?.value;
const pageTitle = title ? `${title} — ${storeName} 管理后台` : `${storeName} 管理后台`;
const shippingIssue = shippingFor(Astro.locals.settings).issue;
const inventoryExceptionCount = await countUnresolvedInventoryExceptions(env.DB);

const nav: { key: Section; label: string; href: string }[] = [
  { key: 'dashboard', label: '仪表盘', href: '/admin' },
  { key: 'products', label: '商品', href: '/admin/products' },
  { key: 'orders', label: '订单', href: '/admin/orders' },
  { key: 'customers', label: '客户', href: '/admin/customers' },
  { key: 'categories', label: '分类', href: '/admin/categories' },
  { key: 'pages', label: '页面', href: '/admin/pages' },
  { key: 'navigation', label: '导航', href: '/admin/navigation' },
  { key: 'shipping', label: '配送', href: '/admin/shipping' },
  { key: 'media', label: '媒体库', href: '/admin/media' },
  { key: 'settings', label: '设置', href: '/admin/settings' },
];
const currentLabel = nav.find((n) => n.key === active)?.label ?? '菜单';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-paper text-ink antialiased">
    <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-8 sm:flex-row sm:gap-10">
      <aside class="w-full shrink-0 sm:w-52 sm:border-r sm:border-line sm:pr-6">
        <a href="/" class="mb-4 block font-serif text-xl tracking-tight sm:mb-8">{storeName}</a>

        <input
          type="checkbox"
          id="admin-nav"
          data-admin-nav-toggle
          class="peer sr-only"
          aria-label="展开或收起后台菜单"
        />
        <label
          for="admin-nav"
          data-admin-nav-summary
          class="flex cursor-pointer select-none items-center justify-between gap-3 rounded-md border border-line bg-white/60 px-4 py-3 transition hover:border-brand sm:hidden"
        >
          <span class="flex flex-col gap-0.5">
            <span class="text-[0.625rem] uppercase tracking-[0.25em] text-gray-400">管理后台</span>
            <span class="font-serif text-lg leading-none tracking-tight text-gray-900">{currentLabel}</span>
          </span>
          <svg data-admin-nav-chevron class="size-4 shrink-0 text-gray-400 transition-transform duration-300" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M5 7.5 10 12.5 15 7.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </label>

        <nav
          data-admin-nav-list
          class="mt-2 hidden overflow-hidden rounded-md border border-line bg-white/60 text-xs uppercase tracking-widest peer-checked:block sm:mt-0 sm:block sm:space-y-0.5 sm:rounded-none sm:border-0 sm:bg-transparent"
        >
          {nav.map((n) => (
            <a
              href={n.href}
              aria-current={active === n.key ? 'page' : undefined}
              class={`flex items-center justify-between border-b border-l-2 border-line px-4 py-3 transition last:border-b-0 sm:block sm:border-b-0 sm:px-3 sm:py-1.5 ${
                active === n.key
                  ? 'border-l-brand bg-paper font-medium text-brand sm:bg-transparent'
                  : 'border-l-transparent text-gray-500 hover:bg-paper hover:text-brand sm:hover:bg-transparent'
              }`}
            >
              <span>{n.label}</span>
              {active === n.key && <span aria-hidden="true" class="size-1.5 rounded-full bg-brand sm:hidden" />}
            </a>
          ))}
        </nav>

        <div class="mt-4 flex gap-4 text-xs uppercase tracking-widest text-gray-400 sm:mt-8 sm:flex-col sm:gap-2">
          <a href="/" class="hover:text-brand">&larr; 查看商城</a>
          {showLogout && <a href="/admin/logout" class="hover:text-brand">退出登录</a>}
        </div>
      </aside>

      <main class="min-w-0 flex-1">
        {showSetupNudge && (
          <a href="/admin/setup" class="mb-6 flex items-center justify-between gap-3 rounded-md border border-brand/30 bg-brand/5 px-4 py-3 text-sm text-gray-700 transition hover:border-brand">
            <span>
              <strong class="font-semibold">完成商城设置</strong> — 设置商城名称、支付状态及其他配置。
            </span>
            <span aria-hidden="true" class="text-brand">&rarr;</span>
          </a>
        )}
        {Astro.locals.settings && paymentsInDemoMode(Astro.locals.settings) && (
          <div class="mb-6 rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-800">
            <strong class="font-semibold">尚未配置真实支付方式。</strong> 当前只能使用<strong>演示结账</strong>收取订单；订单会被记录并标记为 <code class="rounded bg-amber-100 px-1 text-xs">demo</code>。
          </div>
        )}
        {shippingIssue && (
          <a href="/admin/shipping" class="mb-6 flex items-center justify-between gap-3 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 transition hover:border-red-500">
            <span>
              <strong class="font-semibold">配送结账因配置无效而被阻止：</strong>{' '}
              {shippingIssue.reason}
            </span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        )}
        {inventoryExceptionCount > 0 && (
          <a href="/admin/orders#inventory-exceptions" class="mb-6 flex items-center justify-between gap-3 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 transition hover:border-red-500">
            <span>
              <strong class="font-semibold">库存需要处理。</strong>{' '}
              有 {inventoryExceptionCount} 条已支付订单在库存预留结束后到达，无法完整扣减库存。请打开相关订单并核对库存。
            </span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        )}
        <slot />
      </main>
    </div>
  </body>
</html>
