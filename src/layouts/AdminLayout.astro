---
import { getConfig } from '../config';
import { paymentsInDemoMode } from '../features/payments';
import { shippingFor } from '../features/shipping/effective';
import { env } from 'cloudflare:workers';
import { countUnresolvedInventoryExceptions } from '../features/orders/db';
import '../styles/admin.css';

type Section = 'dashboard' | 'products' | 'orders' | 'customers' | 'categories' | 'media' | 'pages' | 'navigation' | 'shipping' | 'settings';
interface Props { title?: string; active?: Section; }
const { title, active } = Astro.props;
const config = getConfig();
const storeName = Astro.locals.settings?.storeName ?? config.storeName;
const showSetupNudge = !Astro.locals.settings?.setupComplete && Astro.url.pathname !== '/admin/setup';
const showLogout = !!Astro.cookies.get('admin_session')?.value;
const pageTitle = title ? `${title} — ${storeName} 管理后台` : `${storeName} 管理后台`;
const shippingIssue = shippingFor(Astro.locals.settings).issue;
const inventoryExceptionCount = await countUnresolvedInventoryExceptions(env.DB);
const nav: { key: Section; label: string; href: string }[] = [
  { key: 'dashboard', label: '仪表盘', href: '/admin' },
  { key: 'products', label: '商品', href: '/admin/products' },
  { key: 'orders', label: '订单', href: '/admin/orders' },
  { key: 'customers', label: '客户', href: '/admin/customers' },
  { key: 'categories', label: '分类', href: '/admin/categories' },
  { key: 'pages', label: '页面', href: '/admin/pages' },
  { key: 'navigation', label: '导航', href: '/admin/navigation' },
  { key: 'shipping', label: '配送', href: '/admin/shipping' },
  { key: 'media', label: '媒体库', href: '/admin/media' },
  { key: 'settings', label: '设置', href: '/admin/settings' },
];
const currentLabel = nav.find((n) => n.key === active)?.label ?? '菜单';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-paper text-ink antialiased">
    <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-8 sm:flex-row sm:gap-10">
      <aside class="w-full shrink-0 sm:w-52 sm:border-r sm:border-line sm:pr-6">
        <a href="/" class="mb-4 block font-serif text-xl tracking-tight sm:mb-8">{storeName}</a>
        <input type="checkbox" id="admin-nav" data-admin-nav-toggle class="peer sr-only" aria-label="展开或收起后台菜单" />
        <label for="admin-nav" data-admin-nav-summary class="flex cursor-pointer select-none items-center justify-between gap-3 rounded-md border border-line bg-white/60 px-4 py-3 transition hover:border-brand sm:hidden">
          <span class="flex flex-col gap-0.5"><span class="text-[0.625rem] uppercase tracking-[0.25em] text-gray-400">管理后台</span><span class="font-serif text-lg leading-none tracking-tight text-gray-900">{currentLabel}</span></span>
          <svg data-admin-nav-chevron class="size-4 shrink-0 text-gray-400 transition-transform duration-300" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 7.5 10 12.5 15 7.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </label>
        <nav data-admin-nav-list class="mt-2 hidden overflow-hidden rounded-md border border-line bg-white/60 text-xs uppercase tracking-widest peer-checked:block sm:mt-0 sm:block sm:space-y-0.5 sm:rounded-none sm:border-0 sm:bg-transparent">
          {nav.map((n) => (
            <a href={n.href} aria-current={active === n.key ? 'page' : undefined} class={`flex items-center justify-between border-b border-l-2 border-line px-4 py-3 transition last:border-b-0 sm:block sm:border-b-0 sm:px-3 sm:py-1.5 ${active === n.key ? 'border-l-brand bg-paper font-medium text-brand sm:bg-transparent' : 'border-l-transparent text-gray-500 hover:bg-paper hover:text-brand sm:hover:bg-transparent'}`}>
              <span>{n.label}</span>{active === n.key && <span aria-hidden="true" class="size-1.5 rounded-full bg-brand sm:hidden" />}
            </a>
          ))}
        </nav>
        <div class="mt-4 flex gap-4 text-xs uppercase tracking-widest text-gray-400 sm:mt-8 sm:flex-col sm:gap-2"><a href="/" class="hover:text-brand">&larr; 查看商城</a>{showLogout && <a href="/admin/logout" class="hover:text-brand">退出登录</a>}</div>
      </aside>
      <main class="min-w-0 flex-1">
        {showSetupNudge && <a href="/admin/setup" class="mb-6 flex items-center justify-between gap-3 rounded-md border border-brand/30 bg-brand/5 px-4 py-3 text-sm text-gray-700 transition hover:border-brand"><span><strong class="font-semibold">完成商城设置</strong> — 设置商城名称、支付状态及其他配置。</span><span aria-hidden="true" class="text-brand">&rarr;</span></a>}
        {Astro.locals.settings && paymentsInDemoMode(Astro.locals.settings) && <div class="mb-6 rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-800"><strong class="font-semibold">尚未配置真实支付方式。</strong> 当前只能使用<strong>演示结账</strong>收取订单；订单会被记录并标记为 <code class="rounded bg-amber-100 px-1 text-xs">demo</code>。</div>}
        {shippingIssue && <a href="/admin/shipping" class="mb-6 flex items-center justify-between gap-3 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 transition hover:border-red-500"><span><strong class="font-semibold">配送结账因配置无效而被阻止：</strong>{' '}{shippingIssue.reason}</span><span aria-hidden="true">&rarr;</span></a>}
        {inventoryExceptionCount > 0 && <a href="/admin/orders#inventory-exceptions" class="mb-6 flex items-center justify-between gap-3 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 transition hover:border-red-500"><span><strong class="font-semibold">库存需要处理。</strong>{' '}有 {inventoryExceptionCount} 条已支付订单在库存预留结束后到达，无法完整扣减库存。请打开相关订单并核对库存。</span><span aria-hidden="true">&rarr;</span></a>}
        <slot />
      </main>
    </div>
    <script>
      (() => {
        const t: Record<string, string> = {
          Dashboard:'仪表盘', Products:'商品', Product:'商品', Orders:'订单', Order:'订单', Customers:'客户', Categories:'分类', Pages:'页面', Navigation:'导航', Shipping:'配送', Media:'媒体库', Settings:'设置',
          Save:'保存', Cancel:'取消', Delete:'删除', Edit:'编辑', Create:'创建', Update:'更新', Add:'添加', Remove:'删除', Search:'搜索', Filter:'筛选', Reset:'重置', Close:'关闭', Back:'返回', Next:'下一步', Previous:'上一步', Submit:'提交', Confirm:'确认', Loading:'加载中',
          'Save changes':'保存更改', 'Create product':'创建商品', 'Edit product':'编辑商品', 'New product':'新建商品', 'Add product':'添加商品', 'Delete product':'删除商品',
          'View store':'查看商城', 'View Store':'查看商城', 'Log out':'退出登录', 'Log in':'登录', 'Sign in':'登录', Email:'邮箱', Password:'密码', Name:'名称', Description:'描述', Status:'状态', Actions:'操作', Total:'总计', Price:'价格', Quantity:'数量', Stock:'库存', Customer:'客户',
          Payment:'支付', Payments:'支付', 'Payment method':'支付方式', 'Payment reference':'支付参考号', 'Shipping address':'配送地址', 'Shipping method':'配送方式', Tax:'税费', Subtotal:'小计', Discount:'优惠', Refund:'退款', Refunds:'退款', Refunded:'已退款', Pending:'待处理', Paid:'已支付', Cancelled:'已取消', Completed:'已完成', Active:'启用', Inactive:'停用',
          Fulfillment:'履约', Fulfilled:'已履约', Unfulfilled:'未履约', 'All payments':'全部支付状态', 'Any fulfillment':'全部履约状态', 'All methods':'全部方式', Method:'方式', When:'时间', 'Last order':'最近订单', 'Lifetime value':'累计消费', 'No customers yet.':'暂无客户。',
          'Order #':'订单号', 'Public ID':'公开 ID', 'Order # or ID':'订单号或 ID', Find:'查找', 'Export CSV':'导出 CSV', 'Export these':'导出当前结果', 'No order matches':'没有找到匹配的订单。', 'No orders found':'暂无订单', 'No orders yet.':'暂无订单。', 'No products found':'暂无商品', 'No products yet.':'暂无商品。', 'No results':'暂无结果',
          'Inventory reconciliation required':'需要处理库存对账', 'Mark reconciled':'标记为已对账', 'inventory exception':'库存异常', 'inventory exceptions':'库存异常', 'need attention':'需要处理',
          'These paid orders arrived after their stock holds ended. Open each order to reconcile the oversold quantity.':'这些已支付订单在库存预留结束后到达。请打开相关订单并处理超卖数量。', 'No order records this payment':'没有订单记录这笔支付', Dismiss:'忽略', Retry:'重试',
          'Something went wrong':'出了点问题，请稍后重试', 'An error occurred':'发生错误，请稍后重试', 'Are you sure?':'确定要继续吗？', 'Store basics':'商城基本信息', 'Store name':'商城名称', 'Store time zone':'商城时区', 'Admin password':'管理员密码', 'New password':'新密码', 'New password (optional)':'新密码（可选）',
          Demo:'演示', 'Finish setup':'完成设置', 'Set up your store':'设置商城', 'Load the demo catalog':'加载演示商品目录', 'Shipping zones':'配送区域', 'Add zone':'添加区域', 'Remove zone':'删除区域', 'Add rate':'添加配送费率', 'Remove rate':'删除配送费率', 'Add band':'添加区间', 'Remove band':'删除区间',
          'New page':'新建页面', 'Edit page':'编辑页面', 'Create page':'创建页面', 'Delete page':'删除页面', Published:'已发布', Draft:'草稿', 'Add navigation item':'添加导航项', 'Navigation items':'导航项', Label:'标签', URL:'网址', 'Move up':'上移', 'Move down':'下移',
          'Media library':'媒体库', Upload:'上传', 'Copy URL':'复制链接', Copied:'已复制', Unused:'未使用', Used:'已使用', 'Delete media':'删除媒体', 'New category':'新建分类', 'Edit category':'编辑分类', 'Create category':'创建分类', 'Delete category':'删除分类',
          'Customer details':'客户详情', 'Customer orders':'客户订单', 'No orders':'暂无订单', 'Ship to':'配送至', Placed:'下单时间', Tracking:'物流追踪', 'Tracking number':'物流单号', 'Reconcile with Shippo':'与 Shippo 对账', 'Label PDF':'物流标签 PDF',
          'A purchased label is not reflected on this order':'已购买的物流标签尚未同步到此订单', 'The order changed state (refunded or fulfilled another way) while this label was being bought, so its tracking was not applied.':'购买物流标签期间订单状态发生变化（已退款或通过其他方式完成履约），因此物流信息未应用到订单。', 'Force-discarding abandons the single-purchase guarantee for this order':'强制丢弃会放弃此订单的单次购买保障',
          Stripe:'Stripe', Lightning:'闪电网络', Bitcoin:'比特币', OpenNode:'OpenNode', Card:'银行卡', 'Not found':'未找到', Forbidden:'无权访问', Unauthorized:'未授权', 'Server error':'服务器错误', 'Finish setting up your store':'完成商城设置', Admin:'管理后台', Menu:'菜单',
          General:'常规', 'Store identity and storefront features — apply immediately, no redeploy.':'商城信息和前台功能设置——立即生效，无需重新部署。', Images:'图片', 'Choose how product images are delivered. This affects existing and new uploads without changing the files stored in R2.':'选择商品图片的交付方式。此设置会影响现有和新上传的图片，但不会修改 R2 中存储的文件。',
          'Image delivery':'图片交付', 'Original images':'原始图片', 'Payment settings':'支付设置', 'Bot protection':'机器人防护', 'Build-time':'构建时配置', 'Search provider':'搜索服务', 'Email provider':'邮件服务商', 'Email from':'发件邮箱', 'From name':'发件人名称', 'Notify email':'通知邮箱',
          'Search e.g. America/New_York':'例如搜索 America/New_York', 'Current logo':'当前 Logo', 'Replace logo':'更换 Logo', 'Choose logo':'选择 Logo', 'Remove logo':'移除 Logo', Logo:'Logo',
          'Home page':'首页', 'Product list (default)':'商品列表（默认）', 'Link (optional)':'链接（可选）', 'Announcement bar':'公告栏', 'e.g. Free shipping on orders over $50':'例如：满 50 美元免运费', 'e.g. /categories/sale':'例如：/categories/sale',
          'Shipping labels (Shippo)':'配送标签（Shippo）', 'API token':'API 令牌', 'Cart & checkout':'购物车和结账', 'Add to cart and checkout. Off makes the store a browse-only catalog.':'加入购物车并结账。关闭后商城将仅作为商品浏览目录。', 'Buy now':'立即购买', 'Express instant-checkout button on product pages — works even with the cart off.':'商品页上的快速结账按钮——即使关闭购物车也可以使用。', 'Discount codes':'优惠码', 'Automatic tax':'自动税费', 'Customer accounts':'客户账户', 'Optimize images on upload':'上传时优化图片', Unavailable:'不可用',
          'Original image':'原始图片', 'Cloudflare Images':'Cloudflare Images', 'On-demand':'按需', 'Keyword search':'关键词搜索', 'Semantic search':'语义搜索',
          'Turnstile site key':'Turnstile 站点密钥', 'Turnstile secret key':'Turnstile 密钥', 'Enable bot protection':'启用机器人防护', 'Enable email':'启用邮件', 'Enable search':'启用搜索', 'Default payment method':'默认支付方式', 'Payment provider':'支付服务商',
          'Configure this payment method before enabling it.':'启用前请先配置此支付方式。', 'Configure Stripe before enabling this Stripe-only feature.':'启用此 Stripe 专属功能前，请先配置 Stripe。', 'Set AUTH_SECRET before enabling customer accounts.':'启用客户账户前，请先设置 AUTH_SECRET。', 'Enable and configure email before enabling customer accounts.':'启用客户账户前，请先启用并配置邮件。', 'Add the IMAGES binding and redeploy before enabling image optimization.':'启用图片优化前，请添加 IMAGES 绑定并重新部署。',
          'Add the EMAIL binding and redeploy before enabling Cloudflare Email.':'启用 Cloudflare Email 前，请添加 EMAIL 绑定并重新部署。', 'Add a Resend API key before enabling email.':'启用邮件前，请添加 Resend API 密钥。', 'Add both the Turnstile site key and secret before enabling bot protection.':'启用机器人防护前，请同时填写 Turnstile 站点密钥和密钥。', 'Choose an enabled, configured payment method as the default.':'请选择一个已启用且已配置的支付方式作为默认方式。',
          'Choose a valid Lightning backend.':'请选择有效的 Lightning 后端。', 'Choose a valid image delivery method.':'请选择有效的图片交付方式。', 'Add the AI and VECTORIZE bindings before enabling semantic search.':'启用语义搜索前，请添加 AI 和 VECTORIZE 绑定。', 'Settings updated':'设置已更新',
          On:'开启', Off:'关闭', zone:'个配送区域', zones:'个配送区域', 'Weight unit':'重量单位',
          'Add an item':'添加导航项', 'Choose what appears in your header and footer. Changes appear on the storefront within a minute.':'选择显示在商城顶部和底部的导航内容。修改后通常会在一分钟内显示到商城。', Type:'类型', 'Filter by name':'按名称搜索', 'Search all':'搜索全部', Category:'分类', Page:'页面', Home:'首页', Catalog:'商品目录', 'Label (optional)':'标签（可选）', 'Add to':'添加到', Header:'顶部导航', Footer:'底部导航', 'No matches':'没有匹配项', 'None available':'暂无可选项', 'No items yet.':'暂无导航项。', 'Navigation updated.':'导航已更新。', 'Edit link text':'编辑链接文字', 'Link text':'链接文字', Untitled:'未命名', 'Target no longer exists':'目标不存在', 'Draft — hidden on the storefront':'草稿 — 前台不可见', 'Inactive — hidden on the storefront':'已停用 — 前台不可见',
          Apparel:'服饰', Electronics:'电子产品', 'Home & Living':'家居生活', Kitchen:'厨房', Outdoors:'户外', Stationery:'文具',
          'Defaults to its name':'默认使用名称', 'Changes only what this menu shows':'只修改导航中显示的文字', 'leave blank to use':'留空则使用', 'Back to categories':'返回分类管理', 'Category management':'分类管理', 'Parent category':'上级分类', Slug:'链接标识'
        };
        const translate = (root: ParentNode = document.body) => {
          const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
          const nodes: Text[] = []; let n: Node | null;
          while ((n = walker.nextNode())) nodes.push(n as Text);
          for (const node of nodes) { const value = node.nodeValue; if (!value) continue; const key = value.trim(); if (t[key]) node.nodeValue = value.replace(key, t[key]); }
          for (const el of root.querySelectorAll?.('input,textarea,button,[aria-label],[title]') ?? []) for (const attr of ['placeholder','aria-label','title']) { const value = el.getAttribute(attr); if (value && t[value]) el.setAttribute(attr, t[value]); }
        };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => translate()); else translate();
        new MutationObserver((records) => records.forEach((r) => r.addedNodes.forEach((n) => { if (n instanceof HTMLElement) translate(n); }))).observe(document.body, { childList: true, subtree: true });
      })();
    </script>
  </body>
</html>
