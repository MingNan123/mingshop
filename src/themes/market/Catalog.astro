---
import type { CatalogPageModel } from '../../features/storefront/models';
import ProductCard from './ProductCard.astro';
import StoreImage from '../../features/storefront/controls/StoreImage.astro';
import CatalogSort from '../../features/storefront/controls/CatalogSort.astro';
import CatalogPagination from '../../features/storefront/controls/CatalogPagination.astro';
interface Props { model: CatalogPageModel; }
const { model } = Astro.props;
const featured = model.pagination.page === 1 ? model.products[0] : undefined;
const gridProducts = featured ? model.products.slice(1) : model.products;
---
<section class="market-catalog">
  <div class="market-intro">
    <p class="market-eyebrow">MINGSHOP · 数字好物</p>
    <h1>{model.heading}</h1>
    <p class="market-intro-copy">精选软件、模板与数字资源。<br />从一个好想法，到下一件好作品。</p>
    <a class="market-button" href="#products">探索全部产品 <span aria-hidden="true">↓</span></a>
  </div>
  {featured && model.pagination.page === 1 && (
    <section class="market-spotlight" aria-label="产品聚焦">
      <div class="market-spotlight-copy">
        <p class="market-eyebrow">产品聚焦</p>
        <h2>{featured.name}</h2>
        <p class="market-spotlight-description">{featured.description}</p>
        <p class="market-spotlight-price">{featured.formattedPrice}{featured.billingInterval === 'month' ? ' / 月' : featured.billingInterval === 'year' ? ' / 年' : ''}</p>
        <a class="market-button" href={featured.href}>进一步了解 <span aria-hidden="true">↗</span></a>
      </div>
      <a class="market-spotlight-media" href={featured.href} aria-label={`查看 ${featured.name}`}>
        <StoreImage image={{ ...featured.image, priority: true, sizes: '(min-width: 900px) 600px, 90vw' }} class="market-spotlight-image" />
      </a>
    </section>
  )}
  <div id="products" class="market-catalog-heading">
    <div><p class="market-eyebrow">{model.eyebrow}</p><h2>找到你的下一件好工具。</h2></div>
    <p>本页 {model.products.length} 件产品</p>
  </div>
  <div class="market-catalog-toolbar">
    <nav aria-label="商品分类" class="market-category-nav">
      <a class="market-category-link" href={model.allHref ?? '/products'}>全部商品</a>
      {model.categories.map((category) => <a class="market-category-link" href={category.href}>{category.text}</a>)}
    </nav>
    <CatalogSort model={model.sort} class="market-sort" />
  </div>
  {model.products.length === 0 && <p role="status" class="market-empty">暂时没有可购买的产品。可以看看其他分类。</p>}
  {gridProducts.length > 0 && <ul class="market-product-grid">{gridProducts.map((card, index) => <ProductCard card={card} index={index} headingLevel="h3" />)}</ul>}
  <CatalogPagination model={model.pagination} class="mt-10 flex flex-wrap items-center justify-center gap-2 text-sm" />
  <div class="market-closing">
    <p class="market-eyebrow">为创作，留出更多空间。</p>
    <h2>少一点繁琐。<br /><span>多一点可能。</span></h2>
    <p>浏览适合你的数字产品，按自己的节奏开始。</p>
    <a href="#products">继续探索 <span aria-hidden="true">›</span></a>
  </div>
</section>
