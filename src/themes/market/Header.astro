---
import type { StorefrontShellModel } from '../../features/storefront/models';
import StoreNav from '../../features/storefront/controls/StoreNav.astro';
import StoreSearch from '../../features/storefront/controls/StoreSearch.astro';
import StoreCartControl from '../../features/storefront/controls/StoreCartControl.astro';
import StoreAccountControl from '../../features/storefront/controls/StoreAccountControl.astro';

interface Props { model: StorefrontShellModel; }
const { model } = Astro.props;
const link = 'text-[13px] font-medium text-[color:var(--market-muted)] transition-colors hover:text-[color:var(--color-ink)]';
---

{model.announcement && (
  <div class="bg-[color:var(--color-ink)] px-4 py-2 text-center text-[12px] font-medium text-white">
    {model.announcement.href ? (
      <a href={model.announcement.href} class="underline-offset-4 hover:underline">{model.announcement.text}</a>
    ) : model.announcement.text}
  </div>
)}

<header class="sticky top-0 z-30 border-b border-line/80 bg-white/90 backdrop-blur-xl">
  <div class="mx-auto flex min-h-14 max-w-7xl items-center gap-4 px-4 sm:px-6">
    <a href="/" aria-label={model.storeName} class="shrink-0 transition-opacity hover:opacity-70">
      {model.logo ? (
        <img src={model.logo.src} alt={model.logo.alt} class="h-7 max-w-44 object-contain" />
      ) : (
        <span class="text-[18px] font-semibold tracking-[-0.03em]">{model.storeName}</span>
      )}
    </a>

    <nav aria-label="Store" class="hidden min-w-0 flex-1 items-center justify-center lg:flex">
      <StoreNav
        links={model.headerLinks}
        class="flex items-center gap-7 text-[13px]"
        disclosureClass="hidden"
      />
    </nav>

    <div class="ml-auto flex items-center gap-2 sm:gap-3">
      <StoreSearch
        action={model.search.action}
        query={model.search.query}
        class="hidden w-48 rounded-full border border-line bg-[color:var(--market-surface)] px-3 py-1.5 transition-all focus-within:border-[color:var(--color-brand)] focus-within:bg-white md:flex lg:w-56"
        inputClass="w-full bg-transparent text-[13px] focus:outline-none"
      />
      {model.account.enabled && <StoreAccountControl href={model.account.href} class={link} />}
      {model.cart.enabled && (
        <StoreCartControl
          href={model.cart.href}
          class="inline-flex items-center rounded-full border border-[color:var(--color-ink)] px-4 py-1.5 text-[12px] font-semibold text-[color:var(--color-ink)] transition hover:bg-[color:var(--color-ink)] hover:text-white"
        />
      )}
    </div>
  </div>

  <div class="border-t border-line/60 px-4 py-2 md:hidden">
    <StoreSearch
      action={model.search.action}
      query={model.search.query}
      class="flex w-full rounded-full border border-line bg-[color:var(--market-surface)] px-3 py-2 focus-within:border-[color:var(--color-brand)] focus-within:bg-white"
      inputClass="w-full bg-transparent text-[13px] focus:outline-none"
    />
  </div>
</header>
