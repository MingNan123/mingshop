---
import type { Category, CategoryOption } from './db';

interface Props {
  action: string;
  submitLabel: string;
  category?: Category | null;
  /** Valid parent choices (depth-tagged). For edit, excludes self + descendants. */
  parentOptions: CategoryOption[];
  error?: string | null;
}

const { action, submitLabel, category = null, parentOptions, error = null } = Astro.props;
const inputClass =
  'mt-1 w-full rounded-md border border-line px-3 py-2 focus:border-brand focus:outline-none';
---

<form method="POST" action={action} class="max-w-lg space-y-4">
  {
    error && (
      <p class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
        {error}
      </p>
    )
  }

  <div>
    <label class="block text-sm font-medium" for="name">分类名称</label>
    <input id="name" name="name" type="text" required value={category?.name ?? ''} class={inputClass} placeholder="例如：服饰、电子产品、家居生活" />
    <p class="mt-1 text-xs text-gray-500">名称会显示在商城分类、导航和商品筛选中。</p>
  </div>

  <div>
    <label class="block text-sm font-medium" for="slug">
      链接标识 <span class="text-faint">（URL；留空则根据名称自动生成）</span>
    </label>
    <input id="slug" name="slug" type="text" value={category?.slug ?? ''} placeholder="留空自动生成，例如 apparel" class={inputClass} />
  </div>

  <div>
    <label class="block text-sm font-medium" for="parent_id">上级分类</label>
    <select id="parent_id" name="parent_id" class={inputClass}>
      <option value="">— 无（顶级分类）—</option>
      {
        parentOptions.map((o) => (
          <option value={o.public_id} selected={category?.parent_id === o.id}>
            {'  '.repeat(o.depth) + o.name}
          </option>
        ))
      }
    </select>
    <p class="mt-1 text-xs text-gray-500">可以建立多级分类，例如「服饰 → 男装 → 外套」。</p>
  </div>

  <div class="flex gap-3 pt-2">
    <button type="submit" class="rounded-md bg-brand px-5 py-2 font-medium text-on-brand hover:bg-brand-hover">
      {submitLabel}
    </button>
    <a href="/admin/categories" class="rounded-md border border-line px-5 py-2 hover:bg-surface">取消</a>
  </div>
</form>
