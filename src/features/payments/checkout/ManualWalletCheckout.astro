---
import { renderSVG } from 'uqr';
import { getConfig, formatPrice } from '../../../config';
import type { StoreSettings } from '../../settings/db';
import type { PendingPayment } from '../lightning/pending';
import { parseStablecoinSnapshot, type StablecoinNetworkProfile } from '../stablecoin-networks';

interface Props {
  pending: PendingPayment;
  settings: StoreSettings;
  networks?: StablecoinNetworkProfile[];
  declined?: string | null;
}
const { pending, settings, networks = [], declined = null } = Astro.props;

type Snap = { id: number; q: number; n: string; p: number };
let items: Snap[] = [];
try { items = pending.items ? (JSON.parse(pending.items) as Snap[]) : []; } catch { items = []; }

const isStablecoin = pending.backend === 'usdc' || pending.backend === 'usdt';
const token = pending.backend === 'usdt' ? 'USDT' : 'USDC';
const networkSnapshot = isStablecoin ? parseStablecoinSnapshot(pending.stablecoin_network_snapshot) : null;
const CONFIG: Record<string, { title: string; label: string; target: string; hint: string; copyLabel: string }> = {
  alipay: {
    title: '使用支付宝支付', label: '支付宝收款链接', target: settings.alipayPaymentUrl ?? '',
    hint: '应付金额已由商品后台价格锁定。请严格按本页固定金额付款，并在备注中填写订单号。', copyLabel: '复制链接',
  },
  wechatpay: {
    title: '使用微信支付', label: '微信支付收款链接', target: settings.wechatpayPaymentUrl ?? '',
    hint: '应付金额已由商品后台价格锁定。请严格按本页固定金额付款，并在备注中填写订单号。', copyLabel: '复制链接',
  },
};
const stableCfg = {
  title: `使用 ${token} 支付`,
  label: networkSnapshot ? `${networkSnapshot.label} 收款地址` : `${token} 收款地址`,
  target: networkSnapshot?.receiveAddress ?? '',
  hint: networkSnapshot ? `本订单已锁定 ${networkSnapshot.label}。只能通过该网络发送 ${token}，其他网络的转账不会用于确认此订单。` : '',
  copyLabel: '复制地址',
};
const cfg = isStablecoin ? stableCfg : (CONFIG[pending.backend] ?? CONFIG.alipay);
const total = formatPrice(pending.amount_total_cents, pending.currency);
const stablecoinAmount = pending.currency.toLowerCase() === 'usd' ? (pending.amount_total_cents / 100).toFixed(2) : null;
const shipping = pending.shipping_cents ? formatPrice(pending.shipping_cents, pending.currency) : null;
const orderMemo = pending.public_id;
const qrValue = networkSnapshot ? networkSnapshot.receiveAddress : (!isStablecoin ? cfg.target || orderMemo : '');
const qrSvg = qrValue ? renderSVG(qrValue, { border: 2 }) : null;
const { storeName } = getConfig();
---

<div class="mx-auto max-w-md">
  <h1 class="mb-1 font-serif text-3xl tracking-tight sm:text-4xl">{cfg.title}</h1>
  <p class="mb-4 text-sm text-muted">{storeName}</p>

  <div class="mb-4 rounded-lg border border-brand/30 bg-brand/5 px-4 py-3 text-center">
    <p class="text-xs uppercase tracking-widest text-muted">固定应付金额</p>
    <p class="mt-1 text-3xl font-semibold tabular-nums">{isStablecoin && stablecoinAmount ? `${stablecoinAmount} ${token}` : total}</p>
    {isStablecoin && pending.currency.toLowerCase() !== 'usd' && <p class="mt-2 text-xs text-red-700">当前店铺币种不是 USD，稳定币自动验单已暂停。</p>}
    <p class="mt-1 text-xs text-muted">金额来自商品后台价格、规格/附加项和运费，结账时不可修改。</p>
  </div>

  <div class="mb-6 rounded-lg border border-line bg-surface p-4">
    <ul class="divide-y divide-line text-sm">
      {items.map((it) => <li class="flex items-center justify-between gap-3 py-2"><span class="min-w-0 truncate">{it.n} <span class="text-faint">x {it.q}</span></span><span class="shrink-0 tabular-nums">{formatPrice(it.p * it.q, pending.currency)}</span></li>)}
    </ul>
    {shipping && <div class="flex items-center justify-between border-t border-line pt-2 text-sm text-muted"><span>运费</span><span class="tabular-nums">{shipping}</span></div>}
    <div class="mt-2 flex items-center justify-between border-t border-line pt-2 text-base font-medium"><span>合计</span><span class="tabular-nums">{total}</span></div>
  </div>

  {declined && <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{declined}</p>}

  {isStablecoin && !networkSnapshot ? (
    <form method="POST" class="mb-6 space-y-4 rounded-lg border border-line bg-surface p-4">
      <div>
        <h2 class="text-base font-medium">选择 {token} 付款网络</h2>
        <p class="mt-1 text-xs text-muted">下面只有商家已启用的网络。选择后会锁定到本订单，付款地址和自动验单都使用同一网络。</p>
      </div>
      {!pending.email && <div><label class="mb-1 block text-xs font-medium text-muted" for="email">接收订单确认的邮箱</label><input id="email" name="email" type="email" autocomplete="email" required placeholder="you@example.com" class="w-full rounded-md border border-line px-3 py-2 text-sm focus:border-brand focus:outline-none" /></div>}
      {pending.email && <p class="rounded-md bg-white px-3 py-2 text-xs text-muted">订单邮箱：{pending.email}</p>}
      {networks.length > 0 ? (
        <fieldset class="space-y-2">
          <legend class="mb-1 text-xs font-medium text-muted">商家支持的网络</legend>
          {networks.map((network, i) => (
            <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-line p-3 has-[:checked]:border-brand">
              <input type="radio" name="network_id" value={network.id} checked={i === 0} class="mt-1" />
              <span class="min-w-0"><span class="block text-sm font-medium">{network.label}</span><span class="block text-xs text-muted">{network.kind === 'tron' ? 'TRON / TRC-20' : 'EVM / ERC-20'} · {token}</span></span>
            </label>
          ))}
        </fieldset>
      ) : (
        <p class="rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">商家暂未启用可用于 {token} 的付款网络，请返回购物车选择另一种稳定币。</p>
      )}
      <button type="submit" disabled={networks.length === 0} class="w-full rounded-md bg-brand px-5 py-3 text-sm font-medium text-on-brand hover:bg-brand-hover disabled:cursor-not-allowed disabled:opacity-50">锁定网络并继续付款</button>
    </form>
  ) : null}

  {isStablecoin && networkSnapshot ? (
    <>
      <div class="mb-6 rounded-lg border border-line bg-surface p-4 text-center">
        <div class="mb-3 rounded-md border border-brand/30 bg-brand/5 px-3 py-2 text-left">
          <p class="text-xs uppercase tracking-widest text-muted">订单已锁定网络</p>
          <p class="mt-1 font-medium">{networkSnapshot.label}</p>
          <p class="mt-1 text-xs text-muted">{networkSnapshot.kind === 'tron' ? 'TRON / TRC-20' : 'EVM / ERC-20'} · {token}</p>
        </div>
        {qrSvg && <div class="mx-auto mb-4 aspect-square w-full max-w-[16rem] rounded-lg bg-white p-2 [&>svg]:h-full [&>svg]:w-full" set:html={qrSvg} />}
        <p class="mb-1 text-xs uppercase tracking-widest text-muted">{cfg.label}</p>
        <p class="break-all rounded-md border border-line bg-white px-3 py-2 font-mono text-xs text-ink">{cfg.target}</p>
        <button type="button" data-copy data-copy-value={cfg.target} class="mt-3 rounded-md border border-line px-3 py-2 text-xs font-medium uppercase tracking-wider text-muted hover:border-brand hover:text-brand">{cfg.copyLabel}</button>
        <p class="mt-3 text-sm text-muted">{cfg.hint}</p>
        <details class="mt-3 text-left text-xs text-muted"><summary class="cursor-pointer">核对代币合约</summary><p class="mt-2 break-all rounded bg-white p-2 font-mono">{networkSnapshot.tokenAddress}</p></details>
        <p class="mt-3 text-xs text-faint">订单号：<code class="rounded bg-white px-1">{orderMemo}</code></p>
        {pending.email && <p class="mt-1 text-xs text-faint">订单邮箱：{pending.email}</p>}
      </div>
      <div class="space-y-3">
        <div class="rounded-lg border border-line bg-surface px-4 py-4 text-center">
          <p class="text-sm font-medium">等待 {networkSnapshot.label} 链上确认</p>
          <p class="mt-1 text-xs text-muted">付款后无需提交 Tx Hash。系统只检查本订单锁定网络上的代币合约、收款地址、精确金额和确认状态；匹配成功后自动完成订单。</p>
        </div>
        <button type="button" data-refresh class="w-full rounded-md border border-line px-5 py-3 text-sm font-medium hover:border-brand hover:text-brand">刷新付款状态</button>
        <a href="/cart" class="block text-center text-xs uppercase tracking-widest text-faint hover:text-brand">返回购物车</a>
      </div>
    </>
  ) : null}

  {!isStablecoin && (
    <>
      <div class="mb-6 rounded-lg border border-line bg-surface p-4 text-center">
        {qrSvg && <div class="mx-auto mb-4 aspect-square w-full max-w-[16rem] rounded-lg bg-white p-2 [&>svg]:h-full [&>svg]:w-full" set:html={qrSvg} />}
        <p class="mb-1 text-xs uppercase tracking-widest text-muted">{cfg.label}</p>
        <p class="break-all rounded-md border border-line bg-white px-3 py-2 font-mono text-xs text-ink">{cfg.target}</p>
        <p class="mt-3 text-sm text-muted">{cfg.hint}</p>
      </div>
      <form method="POST" class="space-y-4">
        <div><label class="mb-1 block text-xs font-medium text-muted" for="email">接收订单确认的邮箱</label><input id="email" name="email" type="email" value={pending.email ?? ''} autocomplete="email" required class="w-full rounded-md border border-line px-3 py-2 text-sm focus:border-brand focus:outline-none" /></div>
        <div><label class="mb-1 block text-xs font-medium text-muted" for="proof">付款凭证或交易号</label><input id="proof" name="proof" type="text" required class="w-full rounded-md border border-line px-3 py-2 text-sm focus:border-brand focus:outline-none" /></div>
        <button type="submit" class="w-full rounded-md bg-brand px-5 py-3 text-sm font-medium text-on-brand hover:bg-brand-hover">提交付款</button>
      </form>
    </>
  )}
</div>
<script is:inline>
  document.querySelector('[data-copy]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget;
    try { await navigator.clipboard.writeText(btn.dataset.copyValue || ''); const prev = btn.textContent; btn.textContent = '已复制'; setTimeout(() => (btn.textContent = prev), 1500); } catch {}
  });
  document.querySelector('[data-refresh]')?.addEventListener('click', () => location.reload());
  if (document.querySelector('[data-refresh]')) setTimeout(() => location.reload(), 20000);
</script>
