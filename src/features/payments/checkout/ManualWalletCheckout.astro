---
import { renderSVG } from 'uqr';
import { getConfig, formatPrice } from '../../../config';
import type { StoreSettings } from '../../settings/db';
import type { PendingPayment } from '../lightning/pending';

interface Props {
  pending: PendingPayment;
  settings: StoreSettings;
  declined?: string | null;
}
const { pending, settings, declined = null } = Astro.props;

type Snap = { id: number; q: number; n: string; p: number };
let items: Snap[] = [];
try {
  items = pending.items ? (JSON.parse(pending.items) as Snap[]) : [];
} catch {
  items = [];
}

const CONFIG: Record<string, { title: string; label: string; target: string; hint: string; copyLabel: string }> = {
  alipay: {
    title: '使用支付宝支付',
    label: '支付宝收款链接',
    target: settings.alipayPaymentUrl ?? '',
    hint: '请按本页合计金额付款，并在备注中填写订单号。',
    copyLabel: '复制链接',
  },
  wechatpay: {
    title: '使用微信支付',
    label: '微信支付收款链接',
    target: settings.wechatpayPaymentUrl ?? '',
    hint: '请按本页合计金额付款，并在备注中填写订单号。',
    copyLabel: '复制链接',
  },
  usdc: {
    title: '使用 USDC 支付',
    label: `${settings.usdcNetwork ?? 'USDC'} 收款地址`,
    target: settings.usdcAddress ?? '',
    hint: `请在 ${settings.usdcNetwork ?? 'configured'} 网络发送 USDC，并提交交易哈希或付款截图编号。`,
    copyLabel: '复制地址',
  },
};
const cfg = CONFIG[pending.backend] ?? CONFIG.usdc;
const total = formatPrice(pending.amount_total_cents, pending.currency);
const shipping = pending.shipping_cents ? formatPrice(pending.shipping_cents, pending.currency) : null;
const orderMemo = pending.public_id;
const qrValue = pending.backend === 'usdc' ? cfg.target : cfg.target || orderMemo;
const qrSvg = qrValue ? renderSVG(qrValue, { border: 2 }) : null;
const { storeName } = getConfig();
---

<div class="mx-auto max-w-md">
  <h1 class="mb-1 font-serif text-3xl tracking-tight sm:text-4xl">{cfg.title}</h1>
  <p class="mb-6 text-sm text-muted">{storeName}</p>

  <div class="mb-6 rounded-lg border border-line bg-surface p-4">
    <ul class="divide-y divide-line text-sm">
      {items.map((it) => (
        <li class="flex items-center justify-between gap-3 py-2">
          <span class="min-w-0 truncate">
            {it.n} <span class="text-faint">x {it.q}</span>
          </span>
          <span class="shrink-0 tabular-nums">{formatPrice(it.p * it.q, pending.currency)}</span>
        </li>
      ))}
    </ul>
    {shipping && (
      <div class="flex items-center justify-between border-t border-line pt-2 text-sm text-muted">
        <span>运费</span>
        <span class="tabular-nums">{shipping}</span>
      </div>
    )}
    <div class="mt-2 flex items-center justify-between border-t border-line pt-2 text-base font-medium">
      <span>合计</span>
      <span class="tabular-nums">{total}</span>
    </div>
  </div>

  <div class="mb-6 rounded-lg border border-line bg-surface p-4 text-center">
    {qrSvg && (
      <div
        class="mx-auto mb-4 aspect-square w-full max-w-[16rem] rounded-lg bg-white p-2 [&>svg]:h-full [&>svg]:w-full"
        set:html={qrSvg}
      />
    )}
    <p class="mb-1 text-xs uppercase tracking-widest text-muted">{cfg.label}</p>
    <p class="break-all rounded-md border border-line bg-white px-3 py-2 font-mono text-xs text-ink">
      {cfg.target}
    </p>
    <button
      type="button"
      data-copy
      data-copy-value={cfg.target}
      class="mt-3 rounded-md border border-line px-3 py-2 text-xs font-medium uppercase tracking-wider text-muted hover:border-brand hover:text-brand"
    >
      {cfg.copyLabel}
    </button>
    <p class="mt-3 text-sm text-muted">{cfg.hint}</p>
    <p class="mt-2 text-xs text-faint">
      订单备注：<code class="rounded bg-white px-1">{orderMemo}</code>
    </p>
  </div>

  {declined && (
    <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
      {declined}
    </p>
  )}

  <form method="POST" class="space-y-4">
    <div>
      <label class="mb-1 block text-xs font-medium text-muted" for="email">
        接收订单确认的邮箱
      </label>
      <input
        id="email"
        name="email"
        type="email"
        value={pending.email ?? ''}
        autocomplete="email"
        required
        class="w-full rounded-md border border-line px-3 py-2 text-sm focus:border-brand focus:outline-none"
      />
    </div>
    <div>
      <label class="mb-1 block text-xs font-medium text-muted" for="proof">
        付款凭证或交易哈希
      </label>
      <input
        id="proof"
        name="proof"
        type="text"
        required
        placeholder="交易号、哈希、付款截图编号等"
        class="w-full rounded-md border border-line px-3 py-2 text-sm focus:border-brand focus:outline-none"
      />
    </div>
    <button
      type="submit"
      class="w-full rounded-md bg-brand px-5 py-3 text-sm font-medium uppercase tracking-wider text-on-brand hover:bg-brand-hover"
    >
      我已付款，提交订单
    </button>
    <a href="/cart" class="block text-center text-xs uppercase tracking-widest text-faint hover:text-brand">
      取消并返回购物车
    </a>
  </form>
</div>

<script is:inline>
  document.querySelector('[data-copy]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget;
    try {
      await navigator.clipboard.writeText(btn.dataset.copyValue || '');
      const prev = btn.textContent;
      btn.textContent = '已复制';
      setTimeout(() => (btn.textContent = prev), 1500);
    } catch {
      /* The visible value remains selectable when clipboard access is blocked. */
    }
  });
</script>
