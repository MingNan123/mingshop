---
import { renderSVG } from 'uqr';
import { formatPrice } from '../../../config';
import type { PendingPayment } from '../lightning/pending';

interface Props {
  pending: PendingPayment;
  expired?: boolean;
}
const { pending, expired = false } = Astro.props;

const bolt11 = pending.bolt11 ?? '';
const lightningUri = `lightning:${bolt11}`;
const qrSvg = bolt11 ? renderSVG(bolt11, { border: 2 }) : null;
const fiat = formatPrice(pending.amount_total_cents, pending.currency);
const sats = (pending.amount_sat ?? 0).toLocaleString('zh-CN');
const refreshSeconds = 4;
const expiresAtMs = pending.expires_at ? Date.parse(pending.expires_at) : null;
---

{
  expired ? (
    <div class="mx-auto max-w-md text-center">
      <h1 class="mb-2 font-serif text-3xl tracking-tight sm:text-4xl">支付发票已过期</h1>
      <p class="mb-6 text-sm text-muted">
        此闪电网络发票已无法支付，系统不会向你扣款。请重新发起结账。
      </p>
      <a
        href="/cart"
        class="inline-block rounded-md bg-brand px-5 py-2.5 text-sm font-medium text-on-brand hover:bg-brand-hover"
      >
        返回购物车
      </a>
    </div>
  ) : (
    <Fragment>
      <div class="mx-auto max-w-md text-center">
        <h1 class="mb-1 font-serif text-3xl tracking-tight sm:text-4xl">使用闪电网络支付</h1>
        <p class="mb-1 text-3xl font-bold tabular-nums">{sats} 聪</p>
        <p class="mb-6 text-sm text-muted">{fiat} · 扫码或点击进行支付</p>

        <a
          href={lightningUri}
          class="block rounded-xl border border-line bg-surface p-4"
          aria-label="在闪电网络钱包中打开"
        >
          <div
            class="mx-auto aspect-square w-full max-w-[18rem] rounded-lg bg-surface p-2 [&>svg]:h-full [&>svg]:w-full"
            set:html={qrSvg}
          />
        </a>

        <div class="mt-4 text-left">
          <label class="mb-1 block text-xs font-medium text-muted" for="invoice">
            闪电网络支付发票
          </label>
          <div class="flex gap-2">
            <input
              id="invoice"
              value={bolt11}
              readonly
              class="min-w-0 flex-1 truncate rounded-md border border-line bg-surface px-3 py-2 font-mono text-xs"
            />
            <button
              type="button"
              data-copy
              data-invoice={bolt11}
              class="shrink-0 rounded-md bg-brand px-3 py-2 text-sm font-medium text-on-brand hover:bg-brand-hover"
            >
              复制
            </button>
          </div>
        </div>

        <a href={lightningUri} class="mt-4 inline-block text-sm font-medium text-accent">
          在钱包中打开 →
        </a>

        <p class="mt-6 text-xs text-faint" data-status>
          正在等待支付… 页面会自动刷新。
        </p>
      </div>

      <script is:inline define:vars={{ refreshSeconds, expiresAtMs }}>
        const now = Date.now();
        if (!expiresAtMs || now < expiresAtMs) {
          const delay = expiresAtMs
            ? Math.min(refreshSeconds * 1000, expiresAtMs - now + 500)
            : refreshSeconds * 1000;
          setTimeout(() => location.reload(), Math.max(delay, 500));
        }

        document.querySelector('[data-copy]')?.addEventListener('click', async (e) => {
          const btn = e.currentTarget;
          try {
            await navigator.clipboard.writeText(btn.dataset.invoice || '');
            const prev = btn.textContent;
            btn.textContent = '已复制';
            setTimeout(() => (btn.textContent = prev), 1500);
          } catch {
            /* 剪贴板不可用时，用户仍可手动选择并复制发票 */
          }
        });
      </script>
    </Fragment>
  )
}
