---
import type { Product } from './db';
import type { CategoryOption } from '../categories/db';
import { getConfig, toMajorUnits, currencyDecimals } from '../../config';
import { formatWeightValue, type WeightUnit } from '../shipping/weight';
import { attachmentActive } from '../digitalDelivery/rollout.ts';

interface Props { action:string; submitLabel:string; product?:Product|null; error?:string|null; categoryOptions?:CategoryOption[]; selectedCategoryIds?:number[]; showImage?:boolean; formId?:string; weightUnit?:WeightUnit; weightRequired?:boolean; }
const { action, submitLabel, product=null, error=null, categoryOptions=[], selectedCategoryIds=[], showImage=true, formId, weightUnit='g', weightRequired=false } = Astro.props;
const selected = new Set(selectedCategoryIds);
const defaultCurrency = product?.currency ?? getConfig().currency;
const priceDecimals = currencyDecimals(defaultCurrency);
const price = product ? toMajorUnits(product.price_cents, product.currency).toFixed(currencyDecimals(product.currency)) : '';
const priceStep = priceDecimals > 0 ? (10 ** -priceDecimals).toFixed(priceDecimals) : '1';
const inputClass = 'mt-1 w-full rounded-md border border-line px-3 py-2 focus:border-brand focus:outline-none';
---

<form method="POST" action={action} enctype="multipart/form-data" id={formId} class="max-w-4xl space-y-6">
  {error && <p class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{error}</p>}

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem]">
    <div class="space-y-6">
      <section id="basic" class="scroll-mt-24 rounded-lg border border-line bg-white p-5">
        <div class="mb-5"><h2 class="font-medium">基本信息</h2><p class="mt-1 text-xs text-gray-500">商品名称、链接地址和详细描述。</p></div>
        <div class="space-y-4">
          <div><label class="block text-sm font-medium" for="name">商品名称</label><input id="name" name="name" type="text" required value={product?.name ?? ''} class={inputClass} /></div>
          <div><label class="block text-sm font-medium" for="slug">商品链接 <span class="text-faint">（留空自动生成）</span></label><input id="slug" name="slug" type="text" value={product?.slug ?? ''} placeholder="auto-from-name" class={inputClass} /></div>
          <div><label class="block text-sm font-medium" for="description">商品描述</label><textarea id="description" name="description" rows="7" class={inputClass}>{product?.description ?? ''}</textarea><p class="mt-1 text-xs text-gray-500">支持纯文本或 Markdown。</p></div>
        </div>
      </section>

      <section id="pricing" class="scroll-mt-24 rounded-lg border border-line bg-white p-5">
        <div class="mb-5"><h2 class="font-medium">价格与库存</h2><p class="mt-1 text-xs text-gray-500">价格使用商城默认货币，库存为当前可销售数量。</p></div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div><label class="block text-sm font-medium" for="price">价格（{defaultCurrency.toUpperCase()}）</label><input id="price" name="price" type="number" step={priceStep} min="0" required value={price} class={inputClass} /></div>
          <div><label class="block text-sm font-medium" for="stock">库存</label><input id="stock" name="stock" type="number" step="1" min="0" value={product?.stock ?? 0} class={inputClass} /></div>
        </div>
      </section>

      {attachmentActive() && <section id="shipping" class="scroll-mt-24 rounded-lg border border-line bg-white p-5">
        <div class="mb-4"><h2 class="font-medium">配送设置</h2><p class="mt-1 text-xs text-gray-500">实体商品可设置配送和包装后的商品重量。</p></div>
        <label class="flex items-center gap-2 text-sm"><input name="requires_shipping" type="checkbox" checked={product ? product.requires_shipping === 1 : true} class="h-4 w-4" />需要配送</label>
        <div class="mt-4"><label class="block text-sm font-medium" for="weight">重量（{weightUnit}）</label><input id="weight" name="weight" type="text" inputmode="decimal" value={product?.weight_grams != null ? formatWeightValue(product.weight_grams, weightUnit) : ''} class={inputClass} /><p class="mt-1 text-xs text-gray-500">{weightRequired ? '当前配送区域按重量计费，重量为必填项。' : '当前可选填重量。'}</p></div>
      </section>}

      <section id="digital" class="scroll-mt-24 rounded-lg border border-line bg-white p-5">
        <div class="mb-4"><h2 class="font-medium">数字商品</h2><p class="mt-1 text-xs text-gray-500">付款成功后可向客户提供私密下载。</p></div>
        {product?.file_key && <p class="mb-3 text-sm text-gray-600">已附加：<strong>{product.file_name ?? 'download'}</strong>{product.file_size_bytes != null && `（${Math.ceil(product.file_size_bytes / 1024)} KB）`}</p>}
        <label class="block text-sm font-medium" for="deliverable">{product?.file_key ? '替换文件' : '添加文件'}</label><input id="deliverable" name="deliverable" type="file" accept=".pdf,.zip,.epub,.mp3,.m4a,.txt" class="mt-2 block w-full text-sm text-gray-600" />
        <p class="mt-1 text-xs text-gray-500">支持 PDF、ZIP、EPUB、MP3、M4A、TXT，最大 25 MB。</p>
        {product?.file_key && <label class="mt-3 flex items-center gap-2 text-sm"><input type="checkbox" name="remove_deliverable" class="h-4 w-4" />删除数字附件</label>}
      </section>

      {showImage && <section class="rounded-lg border border-line bg-white p-5"><h2 class="mb-4 font-medium">商品图片</h2><input id="image" name="image" type="file" accept="image/*" class="block w-full text-sm text-gray-600" /></section>}

      {categoryOptions.length > 0 && <section id="categories" class="scroll-mt-24 rounded-lg border border-line bg-white p-5"><div class="mb-4"><h2 class="font-medium">商品分类</h2><p class="mt-1 text-xs text-gray-500">一个商品可以属于多个分类。</p></div><div class="max-h-56 space-y-1 overflow-auto rounded-md border border-line p-3">{categoryOptions.map((c) => (<label class="flex items-center gap-2 py-1 text-sm" style={`padding-left:${c.depth * 16}px`}><input type="checkbox" name="category" value={c.public_id} checked={selected.has(c.id)} class="h-4 w-4" />{c.name}</label>))}</div></section>}
    </div>

    <aside class="h-fit space-y-4 lg:sticky lg:top-6">
      <section class="rounded-lg border border-line bg-white p-5"><h2 class="font-medium">发布</h2><label class="mt-4 flex items-center gap-2 text-sm"><input name="active" type="checkbox" checked={product ? product.active === 1 : true} class="h-4 w-4" />立即上架到商城</label><p class="mt-2 text-xs text-gray-500">关闭后商品不会在商城公开显示。</p><input type="hidden" name="currency" value={defaultCurrency} /><div class="mt-5 grid gap-2"><button type="submit" class="rounded-md bg-brand px-5 py-2.5 font-medium text-on-brand hover:bg-brand-hover">{submitLabel}</button><a href="/admin/products" class="rounded-md border border-line px-5 py-2.5 text-center hover:bg-surface">取消</a></div></section>
      {product && <nav class="rounded-lg border border-line bg-white p-4"><p class="mb-2 text-xs font-medium uppercase tracking-widest text-gray-400">快速定位</p><div class="grid gap-1 text-sm"><a href="#basic" class="hover:text-brand">基本信息</a><a href="#pricing" class="hover:text-brand">价格与库存</a>{attachmentActive() && <a href="#shipping" class="hover:text-brand">配送设置</a>}<a href="#digital" class="hover:text-brand">数字商品</a><a href="#categories" class="hover:text-brand">商品分类</a><a href="#gallery" class="hover:text-brand">商品图片库</a><a href="#options" class="hover:text-brand">规格与附加选项</a></div></nav>}
    </aside>
  </div>
</form>
